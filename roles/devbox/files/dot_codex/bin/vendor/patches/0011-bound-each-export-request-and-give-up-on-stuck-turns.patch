+
+const CAP = 64 * 1024;
+// The stub refuses what the edge would: a body over its receiver limit.
+const RECEIVER_LIMIT = 2 * CAP;
+
+type OtlpAttribute = { key: string; value: { stringValue?: string; intValue?: string } };
+type OtlpSpan = { name: string; spanId: string; attributes?: OtlpAttribute[] };
+type OtlpBody = { resourceSpans?: Array<{ scopeSpans?: Array<{ spans?: OtlpSpan[] }> }> };
+type Request = { bytes: number; spans: OtlpSpan[] };
+
+const tmpDirs: string[] = [];
+const servers: http.Server[] = [];
+
+afterEach(async () => {
+  vi.restoreAllMocks();
+  while (servers.length) {
+    const server = servers.pop()!;
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+  while (tmpDirs.length) fs.rmSync(tmpDirs.pop()!, { recursive: true, force: true });
+});
+
+async function startCollector(): Promise<{ baseUrl: string; requests: Request[] }> {
+  const requests: Request[] = [];
+  const server = http.createServer((req, res) => {
+    const chunks: Buffer[] = [];
+    req.on("data", (chunk) => chunks.push(chunk as Buffer));
+    req.on("end", () => {
+      const body = Buffer.concat(chunks);
+      if (body.length > RECEIVER_LIMIT) {
+        res.writeHead(413, { "content-type": "text/plain" });
+        res.end("request body too large");
+        return;
+      }
+      const parsed = JSON.parse(body.toString("utf-8")) as OtlpBody;
+      const spans = (parsed.resourceSpans ?? [])
+        .flatMap((r) => r.scopeSpans ?? [])
+        .flatMap((s) => s.spans ?? []);
+      requests.push({ bytes: body.length, spans });
+      res.writeHead(200, { "content-type": "application/json" });
+      res.end("{}");
+    });
+  });
+  servers.push(server);
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const { port } = server.address() as { port: number };
+  return { baseUrl: `http://127.0.0.1:${port}`, requests };
+}
+
+function writeRollout(turns: Array<{ id: string; prompt: string }>): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "lf-codex-bound-"));
+  tmpDirs.push(dir);
+  const day = path.join(dir, "sessions", "2026", "06", "03");
+  fs.mkdirSync(day, { recursive: true });
+  const line = (type: string, payload: Record<string, unknown>) =>
+    JSON.stringify({ timestamp: "2026-06-03T12:00:00.000Z", type, payload });
+  const lines = [line("session_meta", { id: "sess-bound", cli_version: "0.163.0" })];
+  for (const turn of turns) {
+    lines.push(
+      line("event_msg", { type: "task_started", turn_id: turn.id }),
+      line("event_msg", { type: "user_message", message: turn.prompt }),
+      line("response_item", {
+        type: "message",
+        role: "assistant",
+        content: [{ type: "output_text", text: `Answer to ${turn.id}.` }],
+      }),
+      line("event_msg", { type: "task_complete", turn_id: turn.id }),
+    );
+  }
+  const rollout = path.join(day, "rollout-bound.jsonl");
+  fs.writeFileSync(rollout, lines.join("\n") + "\n");
+  return rollout;
+}
+
+const configFor = (baseUrl: string): Config => ({
+  enabled: true,
+  public_key: "pk-lf-test",
+  secret_key: "sk-lf-test",
+  base_url: baseUrl,
+  skill_tags: true,
+  max_history_chars: 200_000,
+  debug: false,
+  fail_on_error: false,
+});
+
+const attr = (span: OtlpSpan, key: string): string | undefined => {
+  const value = span.attributes?.find((a) => a.key === key)?.value;
+  return value?.stringValue ?? value?.intValue;
+};
+
+describe("OTLP requests bounded by bytes", () => {
+  it("splits a turn larger than the request cap across requests that each fit under it", async () => {
+    const { baseUrl, requests } = await startCollector();
+    const config = configFor(baseUrl);
+    const rollout = writeRollout([{ id: "turn-big", prompt: "a".repeat(40_000) }]);
+    const instrumentation = setupInstrumentation(config, { maxRequestBytes: CAP });
+
+    await convertRollout(rollout, {
+      config,
+      stoppedTurnId: "turn-big",
+      onTurnExported: () => instrumentation.flush(),
+    });
+    await instrumentation.shutdown();
+
+    expect(requests.length).toBeGreaterThan(1);
+    for (const request of requests) expect(request.bytes).toBeLessThanOrEqual(CAP);
+    const names = requests.flatMap((r) => r.spans.map((s) => s.name)).sort();
+    expect(names).toEqual(["Codex Turn", "LLM"]);
+  });
+
+  it("exports a span larger than the cap without its content, and the turns after it", async () => {
+    const stderr = vi.spyOn(process.stderr, "write").mockImplementation(() => true);
+    const { baseUrl, requests } = await startCollector();
+    const config = configFor(baseUrl);
+    const rollout = writeRollout([
+      { id: "turn-1", prompt: "First" },
+      { id: "turn-2", prompt: "x".repeat(100_000) },
+      { id: "turn-3", prompt: "Third" },
+    ]);
+    const instrumentation = setupInstrumentation(config, { maxRequestBytes: CAP });
+    const exported: string[] = [];
+
+    await convertRollout(rollout, {
+      config,
+      stoppedTurnId: "turn-3",
+      onTurnExported: async (turnId) => {
+        await instrumentation.flush();
+        exported.push(turnId);
+      },
+    }).catch(() => undefined);
+    await instrumentation.shutdown().catch(() => undefined);
+
+    expect(exported).toEqual(["turn-1", "turn-2", "turn-3"]);
+    for (const request of requests) expect(request.bytes).toBeLessThanOrEqual(CAP);
+    const spans = requests.flatMap((r) => r.spans);
+    const oversized = spans.filter(
+      (s) => attr(s, "langfuse.observation.metadata.codex.oversized_bytes") !== undefined,
+    );
+    // Turn 3's generation repeats turn 2's prompt in its history.
+    expect(oversized.map((s) => s.name).sort()).toEqual(["Codex Turn", "LLM", "LLM"]);
+    for (const span of oversized) {
+      expect(
+        Number(attr(span, "langfuse.observation.metadata.codex.oversized_bytes")),
+      ).toBeGreaterThan(CAP);
+      expect(attr(span, "langfuse.observation.input")).toBeUndefined();
+      expect(attr(span, "langfuse.observation.level")).toBe("WARNING");
+      expect(attr(span, "langfuse.observation.status_message")).toContain(`${CAP}-byte`);
+    }
+    const turnRoot = oversized.find((s) => s.name === "Codex Turn")!;
+    expect(attr(turnRoot, "langfuse.observation.metadata.codex.turn_id")).toBe("turn-2");
+    const alerts = stderr.mock.calls.map(([chunk]) => String(chunk));
+    expect(alerts.filter((line) => line.includes(`over the ${CAP}-byte request cap`))).toHaveLength(
+      oversized.length,
+    );
+  });
+});
+
+describe("export failures", () => {
+  const withCode = (code: string | number) => Object.assign(new Error("export failed"), { code });
+
+  it("does not hold an unreachable collector against the turn", () => {
+    expect(exportFailureKind(withCode("ECONNREFUSED"))).toBe("unreachable");
+  });
+
+  it("treats a 4xx other than 408 and 429 as a rejection of the request itself", () => {
+    expect(exportFailureKind(withCode(413))).toBe("rejected");
+    expect(exportFailureKind(withCode(400))).toBe("rejected");
+    expect(exportFailureKind(withCode(408))).toBe("failed");
+    expect(exportFailureKind(withCode(429))).toBe("failed");
+    expect(exportFailureKind(withCode(500))).toBe("failed");
+    expect(exportFailureKind(new Error("Request timed out"))).toBe("failed");
+  });
+
+  it("gives a request more time the larger it is, within the Stop hook's budget", () => {
+    expect(requestTimeoutMillis(1024)).toBe(6_000);
+    expect(requestTimeoutMillis(16 * 1024 * 1024)).toBe(13_000);
+    expect(requestTimeoutMillis(96 * 1024 * 1024)).toBe(20_000);
+  });
+});
