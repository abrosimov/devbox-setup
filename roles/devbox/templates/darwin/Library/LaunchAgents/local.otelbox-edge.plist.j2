<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Managed by devbox (roles/devbox/templates/darwin/Library/LaunchAgents/local.otelbox-edge.plist.j2).
  Supervises the published otelcol-otelbox binary in its edge role, via the
  wrapper (see darwin/install_otelbox_edge.yml). Replaces `brew services` — and
  Homebrew is not an installation path here at all; the playbook owns the binary.
  This plist's EnvironmentVariables inject the two per-profile, non-secret values
  the wrapper can't source from a file/keychain:
    - OTELBOX_EDGE_STORAGE       : file_storage WAL root.
    - OTEL_RESOURCE_ATTRIBUTES   : read by the edge layer's `env` resource
                                   detector to stamp every signal with the
                                   originating profile ({{ devbox_active_profile | default('personal') }}).
  The wrapper adds OTELBOX_EDGE_ENDPOINT (overlay file) + OTELBOX_EDGE_TOKEN
  (login keychain). KeepAlive true: it's a long-running daemon, restarted on exit.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.otelbox-edge</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ ansible_facts['env']['HOME'] }}/.config/otelbox/edge/otelbox-edge-run</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OTELBOX_EDGE_STORAGE</key>
        <string>{{ ansible_facts['env']['HOME'] }}/.local/state/otelbox/edge</string>
        <key>OTEL_RESOURCE_ATTRIBUTES</key>
        <string>deployment.environment.name={{ devbox_active_profile | default('personal') }}</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>{{ ansible_facts['env']['HOME'] }}/Library/Logs/otelbox-edge.log</string>

    <key>StandardErrorPath</key>
    <string>{{ ansible_facts['env']['HOME'] }}/Library/Logs/otelbox-edge.log</string>
</dict>
</plist>
