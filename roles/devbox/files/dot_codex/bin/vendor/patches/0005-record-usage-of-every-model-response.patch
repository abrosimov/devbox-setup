--- a/plugins/tracing/test/hook-command.test.ts
+++ b/plugins/tracing/test/hook-command.test.ts
@@ -926,4 +926,71 @@ describe("subagent turns that run after the spawning turn", () => {
     expect(nested[0].parentSpanId).toBe(exec.spanId);
     expect(nested[0].attributes["langfuse.observation.level"]).toBe("ERROR");
   });
+
+  describe("with a response before the spawn that reported only usage", () => {
+    const usage = { input_tokens: 900, output_tokens: 100, total_tokens: 1000 };
+    const usageOnlyResponse = [
+      line("2026-06-03T12:00:01.200Z", "response_item", {
+        type: "reasoning",
+        summary: [],
+        content: null,
+        encrypted_content: "gAAAAABq-hyV…",
+      }),
+      event("2026-06-03T12:00:01.300Z", {
+        type: "token_count",
+        info: { total_token_usage: usage, last_token_usage: usage },
+      }),
+    ];
+    const parentT1WithUsage = [...parentT1.slice(0, 3), ...usageOnlyResponse, ...parentT1.slice(3)];
+    const usageDetailsOf = (bodies: string[]) =>
+      exportedSpans(bodies)
+        .map((span) => span.attributes["langfuse.observation.usage_details"])
+        .filter((details): details is string => Boolean(details))
+        .map((details) => JSON.parse(details) as { total_tokens: number });
+
+    it("leaves the ids of the turn's other observations as they were without it", async () => {
+      const exportParentT1 = (lines: string[]) =>
+        runHooks(async ({ parent, child, write, hook }) => {
+          write(parent, lines);
+          write(child, childC1);
+          await hook({ hook_event_name: "Stop", turn_id: "parent-t1" });
+        });
+      const ids = (bodies: string[]) =>
+        exportedSpans(bodies)
+          .filter((span) => !span.attributes["langfuse.observation.usage_details"])
+          .map((span) => `${span.name} ${span.traceId} ${span.spanId} ${span.parentSpanId}`)
+          .sort();
+
+      const without = await exportParentT1(parentT1);
+      const withUsage = await exportParentT1(parentT1WithUsage);
+
+      expect(usageDetailsOf(withUsage.bodies)).toEqual([
+        expect.objectContaining({ total_tokens: 1000 }),
+      ]);
+      expect(ids(without.bodies).length).toBeGreaterThan(2);
+      expect(ids(withUsage.bodies)).toEqual(ids(without.bodies));
+    });
+
+    it("keeps the spawn_agent span id a later SubagentStop nests under", async () => {
+      const { bodies, child } = await runHooks(async ({ parent, child, write, hook }) => {
+        write(parent, parentT1WithUsage);
+        write(child, childC1);
+        await hook({ hook_event_name: "Stop", turn_id: "parent-t1" });
+
+        write(parent, [...parentT1WithUsage, ...parentT2.slice(0, 4)]);
+        write(child, [...childC1, ...childC2]);
+        await hook({
+          hook_event_name: "SubagentStop",
+          turn_id: "child-c2",
+          agent_transcript_path: child,
+        });
+
+        write(parent, [...parentT1WithUsage, ...parentT2]);
+        await hook({ hook_event_name: "Stop", turn_id: "parent-t2" });
+      });
+
+      expectEachChildTurnOnceUnderSpawn(bodies, child);
+      expect(usageDetailsOf(bodies)).toEqual([expect.objectContaining({ total_tokens: 1000 })]);
+    });
+  });
 });
