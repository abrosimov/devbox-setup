diff --git a/plugins/tracing/test/trace-subagent-tags.test.ts b/plugins/tracing/test/trace-subagent-tags.test.ts
new file mode 100644
index 0000000..a6563e5
--- /dev/null
+++ b/plugins/tracing/test/trace-subagent-tags.test.ts
@@ -0,0 +1,163 @@
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { LangfuseSpanProcessor } from "@langfuse/otel";
+import { InMemorySpanExporter, type ReadableSpan } from "@opentelemetry/sdk-trace-base";
+import { NodeTracerProvider } from "@opentelemetry/sdk-trace-node";
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it } from "vitest";
+
+import type { Config } from "../src/config.js";
+import { convertRollout } from "../src/trace.js";
+
+const baseConfig: Config = {
+  enabled: true,
+  public_key: "pk-lf-test",
+  secret_key: "sk-lf-test",
+  base_url: "https://cloud.langfuse.com",
+  skill_tags: true,
+  max_history_chars: 200_000,
+  debug: false,
+  fail_on_error: false,
+};
+
+const fixtures = path.join(
+  path.dirname(fileURLToPath(import.meta.url)),
+  "fixtures/subagent-attribution",
+);
+
+const exporter = new InMemorySpanExporter();
+let processor: LangfuseSpanProcessor;
+let provider: NodeTracerProvider;
+
+beforeAll(() => {
+  processor = new LangfuseSpanProcessor({
+    publicKey: baseConfig.public_key,
+    secretKey: baseConfig.secret_key,
+    baseUrl: baseConfig.base_url,
+    exportMode: "immediate",
+    exporter,
+    shouldExportSpan: () => true,
+  });
+  provider = new NodeTracerProvider({ spanProcessors: [processor] });
+  provider.register();
+});
+
+afterAll(async () => {
+  await provider.shutdown();
+});
+
+beforeEach(() => {
+  exporter.reset();
+});
+
+const dirs: string[] = [];
+afterEach(() => {
+  while (dirs.length) fs.rmSync(dirs.pop()!, { recursive: true, force: true });
+});
+
+function stageDay(): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "lf-codex-subagent-tags-"));
+  dirs.push(dir);
+  const day = path.join(dir, "sessions", "2026", "11", "15");
+  fs.mkdirSync(day, { recursive: true });
+  return day;
+}
+
+function stageRealFragment(): { parent: string; child: string } {
+  const day = stageDay();
+  fs.cpSync(fixtures, day, { recursive: true });
+  return {
+    parent: path.join(day, "rollout-subagent-parent.jsonl"),
+    child: path.join(day, "rollout-subagent-explorer.jsonl"),
+  };
+}
+
+async function turnRoots(name: string): Promise<ReadableSpan[]> {
+  await processor.forceFlush();
+  return exporter.getFinishedSpans().filter((s) => s.name === name);
+}
+
+const tagsOf = (span: ReadableSpan): unknown => span.attributes["langfuse.trace.tags"];
+
+describe("subagent role tags", () => {
+  it("tags the spawning trace with the role of the subagent it spawned", async () => {
+    await convertRollout(stageRealFragment().parent, { config: baseConfig });
+
+    const [root] = await turnRoots("Codex Turn");
+    const children = await turnRoots("Codex Subagent Turn");
+    expect(tagsOf(root)).toEqual(["subagent:explorer"]);
+    expect(children).toHaveLength(2);
+    for (const child of children) expect(tagsOf(child)).toEqual(["subagent:explorer"]);
+  });
+
+  it("gives a subagent turn attached after its spawning turn that trace's tags", async () => {
+    await convertRollout(stageRealFragment().parent, { config: baseConfig });
+    const [spawningRoot] = await turnRoots("Codex Turn");
+    const spawningTags = tagsOf(spawningRoot);
+    exporter.reset();
+
+    await convertRollout(stageRealFragment().child, {
+      config: baseConfig,
+      attachToSpawningTurn: true,
+    });
+
+    const children = await turnRoots("Codex Subagent Turn");
+    expect(spawningTags).toEqual(["subagent:explorer"]);
+    expect(children).toHaveLength(2);
+    for (const child of children) expect(tagsOf(child)).toEqual(spawningTags);
+  });
+
+  it("tags each distinct role once, in the order the turn spawned them", async () => {
+    const day = stageDay();
+    const at = (second: number) => new Date(Date.UTC(2026, 10, 15, 22, 0, second)).toISOString();
+    const write = (
+      name: string,
+      lines: Array<{ type: string; payload: Record<string, unknown> }>,
+    ) =>
+      fs.writeFileSync(
+        path.join(day, name),
+        lines.map((l, i) => JSON.stringify({ timestamp: at(i), ...l })).join("\n") + "\n",
+      );
+    const started = (threadId: string) => ({
+      type: "event_msg",
+      payload: {
+        type: "item_completed",
+        item: {
+          type: "SubAgentActivity",
+          id: `call-${threadId}`,
+          kind: "started",
+          agent_thread_id: threadId,
+        },
+      },
+    });
+    const roles = { "child-a": "explorer", "child-b": "code-reviewer", "child-c": "explorer" };
+    write("rollout-roles-parent.jsonl", [
+      { type: "session_meta", payload: { id: "sess-roles" } },
+      { type: "event_msg", payload: { type: "task_started", turn_id: "turn-roles" } },
+      ...Object.keys(roles).map(started),
+      { type: "event_msg", payload: { type: "task_complete", turn_id: "turn-roles" } },
+    ]);
+    for (const [threadId, role] of Object.entries(roles)) {
+      write(`rollout-roles-${threadId}.jsonl`, [
+        {
+          type: "session_meta",
+          payload: {
+            id: threadId,
+            parent_thread_id: "sess-roles",
+            thread_source: "subagent",
+            source: {
+              subagent: { thread_spawn: { parent_thread_id: "sess-roles", agent_role: role } },
+            },
+          },
+        },
+      ]);
+    }
+
+    await convertRollout(path.join(day, "rollout-roles-parent.jsonl"), { config: baseConfig });
+
+    const [root] = await turnRoots("Codex Turn");
+    expect(tagsOf(root)).toEqual(["subagent:explorer", "subagent:code-reviewer"]);
+  });
+});
