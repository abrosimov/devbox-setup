diff --git a/plugins/tracing/src/otlp-spool.ts b/plugins/tracing/src/otlp-spool.ts
new file mode 100644
index 0000000..2a71cc2
--- /dev/null
+++ b/plugins/tracing/src/otlp-spool.ts
@@ -0,0 +1,132 @@
+import { randomUUID } from "node:crypto";
+import * as fs from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { ProtobufTraceSerializer } from "@opentelemetry/otlp-transformer";
+import type { ReadableSpan } from "@opentelemetry/sdk-trace-base";
+
+// The layout `~/.claude/bin/langfuse_replay.py` drains, as the Claude hook's spool writes it:
+// committed `<epoch ns>-<hex>.otlp` protobuf requests, staging per run under `.staging/`.
+export const SPOOL_MAX_BYTES = 2 * 1024 * 1024 * 1024;
+const STAGING = ".staging";
+const ENTRY_SUFFIX = ".otlp";
+
+export function defaultSpoolDirectory(home: string = process.env.HOME ?? os.homedir()): string {
+  return path.join(home, ".codex", "langfuse_state", "langfuse_otlp_spool");
+}
+
+/** The replay drains only to a loopback edge, so only a hook that exports to one spools. */
+export function isLoopbackUrl(url: string): boolean {
+  return url.startsWith("http://127.0.0.1:") || url.startsWith("http://localhost:");
+}
+
+export class SpoolWriteError extends Error {}
+
+const hex = () => randomUUID().replaceAll("-", "");
+
+async function namesIn(directory: string): Promise<string[]> {
+  try {
+    return await fs.readdir(directory);
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw error;
+  }
+}
+
+async function fsyncDirectory(directory: string): Promise<void> {
+  const handle = await fs.open(directory, "r");
+  try {
+    await handle.sync();
+  } finally {
+    await handle.close();
+  }
+}
+
+async function entryBytes(directory: string): Promise<number> {
+  let total = 0;
+  for (const name of await namesIn(directory)) {
+    if (!name.endsWith(ENTRY_SUFFIX)) continue;
+    total += (await fs.stat(path.join(directory, name)).catch(() => undefined))?.size ?? 0;
+  }
+  return total;
+}
+
+async function durableSave(directory: string, payload: Uint8Array): Promise<void> {
+  const name = `${(BigInt(Date.now()) * 1_000_000n).toString().padStart(20, "0")}-${hex()}`;
+  const temporary = path.join(directory, `.${name}.tmp`);
+  try {
+    const handle = await fs.open(temporary, "wx", 0o600);
+    try {
+      await handle.writeFile(payload);
+      await handle.sync();
+    } finally {
+      await handle.close();
+    }
+    await fs.rename(temporary, path.join(directory, `${name}${ENTRY_SUFFIX}`));
+    await fsyncDirectory(directory);
+  } finally {
+    await fs.rm(temporary, { force: true });
+  }
+}
+
+const asSpoolError = (error: unknown): SpoolWriteError =>
+  error instanceof SpoolWriteError
+    ? error
+    : new SpoolWriteError(
+        `Langfuse OTLP spool write failed: ${error instanceof Error ? error.message : String(error)}`,
+      );
+
+/**
+ * Requests staged by this run reach the spool only on `commit`, so a turn that is not marked
+ * leaves nothing behind for the replay to deliver a second time.
+ */
+export class OtlpSpool {
+  private readonly staging: string;
+
+  constructor(
+    readonly directory: string,
+    private readonly maxBytes: number = SPOOL_MAX_BYTES,
+  ) {
+    this.staging = path.join(directory, STAGING, hex());
+  }
+
+  async stage(spans: ReadableSpan[]): Promise<void> {
+    try {
+      const payload = ProtobufTraceSerializer.serializeRequest(spans);
+      if (!payload) throw new SpoolWriteError("the OTLP request could not be encoded");
+      await fs.mkdir(this.staging, { recursive: true, mode: 0o700 });
+      let queued = await entryBytes(this.directory);
+      for (const owner of await namesIn(path.join(this.directory, STAGING))) {
+        queued += await entryBytes(path.join(this.directory, STAGING, owner));
+      }
+      if (queued + payload.byteLength > this.maxBytes) {
+        throw new SpoolWriteError(
+          `Langfuse OTLP spool full: ${queued} bytes queued plus a ${payload.byteLength}-byte ` +
+            `request exceeds ${this.maxBytes} at ${this.directory}; nothing was deleted`,
+        );
+      }
+      await durableSave(this.staging, payload);
+    } catch (error) {
+      throw asSpoolError(error);
+    }
+  }
+
+  async commit(): Promise<void> {
+    try {
+      const staged = (await namesIn(this.staging)).filter((name) => name.endsWith(ENTRY_SUFFIX));
+      for (const name of staged.sort()) {
+        await fs.rename(path.join(this.staging, name), path.join(this.directory, name));
+      }
+      if (staged.length > 0) await fsyncDirectory(this.directory);
+      await fs.rm(this.staging, { recursive: true, force: true });
+    } catch (error) {
+      throw asSpoolError(error);
+    }
+  }
+
+  async discard(): Promise<void> {
+    // Staging left behind is never delivered, and the replay sweeps it after an hour.
+    await fs.rm(this.staging, { recursive: true, force: true }).catch(() => undefined);
+  }
+}
