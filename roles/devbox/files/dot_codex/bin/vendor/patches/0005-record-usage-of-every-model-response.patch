+describe("token usage of every model response", () => {
+  const epoch = Date.parse("2026-11-15T21:00:00.000Z");
+  const at = (seconds: number): number => epoch + seconds * 1000;
+  const line = (seconds: number, type: string, payload: Record<string, unknown>) => ({
+    timestamp: new Date(at(seconds)).toISOString(),
+    type,
+    payload,
+  });
+  const usage = (input: number, output: number) => ({
+    input_tokens: input,
+    cached_input_tokens: 0,
+    output_tokens: output,
+    reasoning_output_tokens: 0,
+    total_tokens: input + output,
+  });
+  const tokenCount = (seconds: number, last: number, cumulative: number) =>
+    line(seconds, "event_msg", {
+      type: "token_count",
+      info: {
+        total_token_usage: usage(cumulative - 100, 100),
+        last_token_usage: usage(last - 100, 100),
+      },
+    });
+  const usageRecord = (seconds: number, responseId: string, total: number) =>
+    line(seconds, "token_usage_record", {
+      turn_id: "turn-usage",
+      response_id: responseId,
+      usage: usage(total - 100, 100),
+    });
+  const encryptedReasoning = (seconds: number) =>
+    line(seconds, "response_item", {
+      type: "reasoning",
+      summary: [],
+      content: null,
+      encrypted_content: "gAAAAABq-hyVylu30rg1P-Nr_x4hWT5b…",
+    });
+  const assistantText = (seconds: number, text: string) =>
+    line(seconds, "response_item", {
+      type: "message",
+      role: "assistant",
+      content: [{ type: "output_text", text }],
+    });
+
+  const dirs: string[] = [];
+  afterEach(() => {
+    while (dirs.length) fs.rmSync(dirs.pop()!, { recursive: true, force: true });
+  });
+
+  function writeRollout(body: unknown[]): string {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "lf-codex-usage-"));
+    dirs.push(dir);
+    const day = path.join(dir, "sessions", "2026", "11", "15");
+    fs.mkdirSync(day, { recursive: true });
+    const file = path.join(day, "rollout-usage.jsonl");
+    const lines = [
+      line(0, "session_meta", { id: "sess-usage", cli_version: "0.169.0" }),
+      line(0, "event_msg", { type: "task_started", turn_id: "turn-usage" }),
+      ...body,
+      line(60, "event_msg", { type: "task_complete", turn_id: "turn-usage" }),
+    ];
+    fs.writeFileSync(file, lines.map((l) => JSON.stringify(l)).join("\n"));
+    return file;
+  }
+
+  const generations = () =>
+    exporter
+      .getFinishedSpans()
+      .filter((s) => obsType(s) === "generation")
+      .sort((a, b) => startMs(a) - startMs(b));
+  const totalTokens = (span: ReadableSpan): number =>
+    Number(JSON.parse(attr(span, "langfuse.observation.usage_details") || "{}").total_tokens ?? 0);
+  const responseId = (span: ReadableSpan): string =>
+    attr(span, "langfuse.observation.metadata.codex.response_id");
+
+  it("gives a response that produced only encrypted reasoning a generation with its usage", async () => {
+    const file = writeRollout([encryptedReasoning(1), tokenCount(2, 1000, 1000)]);
+
+    await convertRollout(file, { config: baseConfig });
+
+    expect(generations().map(totalTokens)).toEqual([1000]);
+  });
+
+  it("keeps the usage of a response reported right after the previous one", async () => {
+    const file = writeRollout([
+      assistantText(1, "Checking"),
+      tokenCount(2, 1000, 1000),
+      tokenCount(3, 1500, 2500),
+    ]);
+
+    await convertRollout(file, { config: baseConfig });
+
+    expect(generations().map(totalTokens)).toEqual([1000, 1500]);
+  });
+
+  it("counts a re-emitted token_count once", async () => {
+    const file = writeRollout([
+      assistantText(1, "Checking"),
+      tokenCount(2, 1000, 1000),
+      tokenCount(2.1, 1000, 1000),
+    ]);
+
+    await convertRollout(file, { config: baseConfig });
+
+    expect(generations().map(totalTokens)).toEqual([1000]);
+  });
+
+  it("takes a compaction's usage from its record, not from the context estimate after it", async () => {
+    const file = writeRollout([
+      assistantText(1, "Checking"),
+      usageRecord(1.5, "resp-answer", 1000),
+      tokenCount(2, 1000, 1000),
+      usageRecord(3, "resp-compaction", 3000),
+      line(3, "compacted", { message: "" }),
+      tokenCount(3.1, 400, 1000),
+    ]);
+
+    await convertRollout(file, { config: baseConfig });
+
+    expect(generations().map(totalTokens)).toEqual([1000, 3000]);
+    expect(generations().map(responseId)).toEqual(["resp-answer", "resp-compaction"]);
+  });
+
+  it("puts every usage record of a real Codex 0.169 session on exactly one generation", async () => {
+    const dir = stageFixtures();
+    const file = path.join(dir, "../../11/15/rollout-usage-main.jsonl");
+    const records = fs
+      .readFileSync(file, "utf-8")
+      .split("\n")
+      .filter(Boolean)
+      .map((raw) => JSON.parse(raw) as { type: string; payload: Record<string, unknown> })
+      .filter((l) => l.type === "token_usage_record")
+      .map((l) => l.payload as { response_id: string; usage: { total_tokens: number } });
+
