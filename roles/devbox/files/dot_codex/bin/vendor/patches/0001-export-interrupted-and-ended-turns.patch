 });
+
+type OtlpValue = { stringValue?: string; boolValue?: boolean; intValue?: number | string };
+type OtlpSpan = { name: string; attributes?: Array<{ key: string; value: OtlpValue }> };
+type OtlpBody = { resourceSpans?: Array<{ scopeSpans?: Array<{ spans?: OtlpSpan[] }> }> };
+
+function exportedTurnRoots(bodies: string[]): Array<Record<string, string>> {
+  return bodies
+    .flatMap((body) => (JSON.parse(body) as OtlpBody).resourceSpans ?? [])
+    .flatMap((resource) => resource.scopeSpans ?? [])
+    .flatMap((scope) => scope.spans ?? [])
+    .filter((span) => span.name === "Codex Turn")
+    .map((span) =>
+      Object.fromEntries(
+        (span.attributes ?? []).map(({ key, value }) => [
+          key,
+          String(value.stringValue ?? value.boolValue ?? value.intValue ?? ""),
+        ]),
+      ),
+    );
+}
+
+describe("hook events that end a turn or a session without Stop", () => {
+  const event = (ts: string, payload: Record<string, unknown>) =>
+    JSON.stringify({ timestamp: ts, type: "event_msg", payload });
+  const sessionMeta = (id: string) =>
+    JSON.stringify({
+      timestamp: "2026-06-03T12:00:00.000Z",
+      type: "session_meta",
+      payload: { id, cli_version: "0.160.1" },
+    });
+
+  async function withCollector(
+    run: (hook: (payload: Record<string, unknown>) => Promise<string[]>) => Promise<void>,
+  ): Promise<void> {
+    const codexHome = makeTempDir("lf-codex-home-");
+    const sessionCwd = makeTempDir("lf-codex-cwd-");
+    let received: string[] = [];
+    const server = http.createServer((req, res) => {
+      const chunks: Buffer[] = [];
+      req.on("data", (chunk) => chunks.push(chunk as Buffer));
+      req.on("end", () => {
+        received.push(Buffer.concat(chunks).toString("utf-8"));
+        res.writeHead(200, { "content-type": "application/json" });
+        res.end("{}");
+      });
+    });
+    await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+    const { port } = server.address() as { port: number };
+
+    const hook = async (payload: Record<string, unknown>): Promise<string[]> => {
+      received = [];
+      const { code } = await runShellCommand(readHookCommand(), {
+        cwd: sessionCwd,
+        env: {
+          ...process.env,
+          PLUGIN_ROOT: pluginRootDir,
+          CODEX_HOME: codexHome,
+          HOME: codexHome,
+          TRACE_TO_LANGFUSE: "true",
+          LANGFUSE_PUBLIC_KEY: "pk-lf-test",
+          LANGFUSE_SECRET_KEY: "sk-lf-test",
+          LANGFUSE_BASE_URL: `http://127.0.0.1:${port}`,
+        },
+        input: JSON.stringify(payload),
+      });
+      expect(code).toBe(0);
+      return received;
+    };
+
+    try {
+      await run(hook);
+    } finally {
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+    }
+  }
+
+  function stageRollout(lines: string[]): string {
+    const sessionsDir = path.join(
+      makeTempDir("lf-codex-sessions-"),
+      "sessions",
+      "2026",
+      "06",
+      "03",
+    );
+    fs.mkdirSync(sessionsDir, { recursive: true });
+    const rollout = path.join(sessionsDir, "rollout.jsonl");
+    fs.writeFileSync(rollout, lines.join("\n") + "\n");
+    return rollout;
+  }
+
+  const sidecar = (rollout: string): string[] =>
+    fs.readFileSync(`${rollout}.langfuse`, "utf-8").split("\n").filter(Boolean);
+
+  it("exports an interrupted turn as aborted before turn_aborted reaches the rollout, once", async () => {
+    const rollout = stageRollout([
+      sessionMeta("sess-interrupt"),
+      event("2026-06-03T12:00:01.000Z", { type: "task_started", turn_id: "turn-int" }),
+      event("2026-06-03T12:00:01.100Z", { type: "user_message", message: "Count to a million" }),
+      event("2026-06-03T12:00:02.000Z", { type: "agent_message", message: "1, 2, 3" }),
+    ]);
+
+    await withCollector(async (hook) => {
+      const interrupted = exportedTurnRoots(
+        await hook({
+          hook_event_name: "Interrupt",
+          session_id: "sess-interrupt",
+          turn_id: "turn-int",
+          transcript_path: rollout,
+        }),
+      );
+      expect(
+        interrupted.map((root) => root["langfuse.observation.metadata.codex.turn_id"]),
+      ).toEqual(["turn-int"]);
+      expect(interrupted[0]["langfuse.observation.level"]).toBe("WARNING");
+      expect(interrupted[0]["langfuse.observation.status_message"]).toBe(
+        "Turn interrupted by user",
+      );
+      expect(interrupted[0]["langfuse.observation.metadata.codex.aborted"]).toBe("true");
+      expect(sidecar(rollout)).toEqual(["turn-int"]);
+
+      fs.appendFileSync(
+        rollout,
+        [
+          event("2026-06-03T12:00:02.004Z", { type: "turn_aborted", turn_id: "turn-int" }),
+          event("2026-06-03T12:01:00.000Z", { type: "task_started", turn_id: "turn-next" }),
+          event("2026-06-03T12:01:00.100Z", { type: "user_message", message: "Stop there" }),
+          event("2026-06-03T12:01:01.000Z", { type: "agent_message", message: "Stopped." }),
+          event("2026-06-03T12:01:01.100Z", { type: "task_complete", turn_id: "turn-next" }),
+        ].join("\n") + "\n",
+      );
+      const stopped = exportedTurnRoots(
+        await hook({
+          hook_event_name: "Stop",
+          session_id: "sess-interrupt",
+          turn_id: "turn-next",
+          transcript_path: rollout,
+        }),
+      );
+      expect(stopped.map((root) => root["langfuse.observation.metadata.codex.turn_id"])).toEqual([
+        "turn-next",
+      ]);
+      expect(sidecar(rollout)).toEqual(["turn-int", "turn-next"]);
+    });
+  });
+
+  it("exports a turn still pending when the session ends, once", async () => {
+    const rollout = stageRollout([
+      sessionMeta("sess-end"),
+      event("2026-06-03T12:00:01.000Z", { type: "task_started", turn_id: "turn-1" }),
+      event("2026-06-03T12:00:01.100Z", { type: "user_message", message: "First" }),
+      event("2026-06-03T12:00:02.000Z", { type: "agent_message", message: "One" }),
+      event("2026-06-03T12:00:02.100Z", { type: "task_complete", turn_id: "turn-1" }),
+      event("2026-06-03T12:01:00.000Z", { type: "task_started", turn_id: "turn-2" }),
+      event("2026-06-03T12:01:00.100Z", { type: "user_message", message: "Second" }),
+      event("2026-06-03T12:01:01.000Z", { type: "agent_message", message: "Two, so far" }),
+    ]);
+    const turnIds = (bodies: string[]) =>
+      exportedTurnRoots(bodies).map((root) => root["langfuse.observation.metadata.codex.turn_id"]);
+
+    await withCollector(async (hook) => {
+      expect(
+        turnIds(
+          await hook({
+            hook_event_name: "Stop",
+            session_id: "sess-end",
+            turn_id: "turn-1",
+            transcript_path: rollout,
+          }),
+        ),
+      ).toEqual(["turn-1"]);
+
+      const sessionEnd = {
+        hook_event_name: "SessionEnd",
+        session_id: "sess-end",
+        transcript_path: rollout,
+        reason: "other",
+      };
+      expect(turnIds(await hook(sessionEnd))).toEqual(["turn-2"]);
+      expect(sidecar(rollout)).toEqual(["turn-1", "turn-2"]);
+
+      expect(turnIds(await hook(sessionEnd))).toEqual([]);
+      expect(sidecar(rollout)).toEqual(["turn-1", "turn-2"]);
+    });
+  });
+});
