+describe("turn output", () => {
+  const epoch = Date.parse("2026-11-15T22:00:00.000Z");
+  const line = (seconds: number, type: string, payload: Record<string, unknown>) => ({
+    timestamp: new Date(epoch + seconds * 1000).toISOString(),
+    type,
+    payload,
+  });
+  const assistantText = (seconds: number, phase: string, text: string) =>
+    line(seconds, "response_item", {
+      type: "message",
+      role: "assistant",
+      phase,
+      content: [{ type: "output_text", text }],
+    });
+  const agentMessageItem = (seconds: number, phase: string, text: string) =>
+    line(seconds, "event_msg", {
+      type: "item_completed",
+      item: {
+        type: "AgentMessage",
+        id: `msg-${seconds}`,
+        phase,
+        content: [{ type: "Text", text }],
+      },
+    });
+  const commentaryThenAnswer = [
+    agentMessageItem(1, "commentary", "Checking the logs."),
+    assistantText(1, "commentary", "Checking the logs."),
+    agentMessageItem(2, "final_answer", "All green."),
+    assistantText(2, "final_answer", "All green."),
+  ];
+
+  const dirs: string[] = [];
+  afterEach(() => {
+    while (dirs.length) fs.rmSync(dirs.pop()!, { recursive: true, force: true });
+  });
+
+  async function rootOutputOf(body: unknown[], end: Record<string, unknown>): Promise<string> {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "lf-codex-output-"));
+    dirs.push(dir);
+    const day = path.join(dir, "sessions", "2026", "11", "15");
+    fs.mkdirSync(day, { recursive: true });
+    const file = path.join(day, "rollout-output.jsonl");
+    const lines = [
+      line(0, "session_meta", { id: "sess-output", cli_version: "0.169.0" }),
+      line(0, "event_msg", { type: "task_started", turn_id: "turn-output" }),
+      ...body,
+      line(60, "event_msg", { turn_id: "turn-output", ...end }),
+    ];
+    fs.writeFileSync(file, lines.map((l) => JSON.stringify(l)).join("\n"));
+    await convertRollout(file, { config: baseConfig });
+    return attr(turnRoots()[0], "langfuse.observation.output");
+  }
+
+  it("answers with the final_answer item, not the commentary before it in the same step", async () => {
+    const output = await rootOutputOf(commentaryThenAnswer, {
+      type: "task_complete",
+      last_agent_message: null,
+    });
+
+    expect(output).toBe("All green.");
+  });
+
+  it("prefers the last_agent_message task_complete reports over every message item", async () => {
+    const output = await rootOutputOf(commentaryThenAnswer, {
+      type: "task_complete",
+      last_agent_message: "All green, and the PR is open.",
+    });
+
+    expect(output).toBe("All green, and the PR is open.");
+  });
+
