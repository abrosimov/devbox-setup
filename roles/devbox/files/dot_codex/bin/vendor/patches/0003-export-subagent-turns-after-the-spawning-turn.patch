+/**
+ * The span a subagent's turns nest under when its spawning turn is exported: that turn's
+ * `spawn_agent` tool span, or its root. Recomputes the ids `emitTurn` draws for the
+ * spawning turn, so a child turn exported later lands in the same trace.
+ */
+async function spawnContextOf(
+  child: SessionMeta,
+  index: SubagentIndex,
+  config: Config,
+  externalParent: SpanContext | undefined,
+  visited: Set<string> = new Set(),
+): Promise<SpawnContext | undefined> {
+  const parentRollout = child.parentThreadId ? index.byThread.get(child.parentThreadId) : undefined;
+  if (!parentRollout || visited.has(parentRollout.threadId)) return undefined;
+  visited.add(parentRollout.threadId);
+
+  const { sessionMeta: parentMeta, turns } = parseSession(await loadSession(parentRollout.file));
+  let turnIndex = turns.findIndex((turn) => turn.subagentThreadIds.includes(child.sessionId));
+  if (turnIndex === -1) {
+    const self = index.byThread.get(child.sessionId);
+    if (!self || turns.length === 0) return undefined;
+    const viaNickname =
+      self.nickname !== undefined ? turnIndexByNickname(turns).get(self.nickname) : undefined;
+    turnIndex = viaNickname ?? turnIndexAt(turns, self.startTime);
+  }
+  const turn = turns[turnIndex];
+
+  let inheritedTraceId: string | undefined;
+  let attributes: TraceAttributes | undefined;
+  if (parentMeta.isSubagentThread) {
+    const grandparent = await spawnContextOf(parentMeta, index, config, externalParent, visited);
+    if (!grandparent) return undefined;
+    inheritedTraceId = grandparent.spanContext.traceId;
+    attributes = grandparent.attributes;
+  } else {
+    const outer = externalParent ?? (await seededTraceParent(config, parentMeta, turnIndex + 1));
+    inheritedTraceId = outer?.traceId;
+    attributes = externalParent ? undefined : traceAttributes(config, parentMeta, turn);
+  }
+
+  // OpenTelemetry draws a span's id before its trace id, and a trace id only for a new root.
+  const seed = `${parentMeta.sessionId}:${turn.turnId ?? "no-turn-id"}`;
+  let draw = 0;
+  let spanId = seededIdAt(seed, "span", draw++);
+  const traceId = inheritedTraceId ?? seededIdAt(seed, "trace", draw++);
+  const spawnCallId = turn.subagentSpawnCallIds[child.sessionId];
+  findSpawn: for (const step of turn.steps) {
+    draw++;
+    for (const tc of step.toolCalls) {
+      const toolSpanId = seededIdAt(seed, "span", draw++);
+      if (spawnCallId !== undefined && tc.callId === spawnCallId) {
+        spanId = toolSpanId;
+        break findSpawn;
+      }
+    }
+  }
+
+  return {
+    spanContext: { traceId, spanId, traceFlags: TraceFlags.SAMPLED, isRemote: true },
+    attributes,
+  };
+}
