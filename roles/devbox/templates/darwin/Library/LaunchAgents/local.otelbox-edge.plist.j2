<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Managed by devbox (roles/devbox/templates/darwin/Library/LaunchAgents/local.otelbox-edge.plist.j2).
  Supervises the published otelcol-otelbox binary in its edge role, via the
  wrapper (see darwin/install_otelbox_edge.yml). Replaces `brew services` — and
  Homebrew is not an installation path here at all; the playbook owns the binary.
  The plist renders production bounds explicitly. The wrapper adds the upstream
  endpoint and a private credential-header file derived from the login Keychain.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.otelbox-edge</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ ansible_facts['env']['HOME'] }}/.config/otelbox/edge/otelbox-edge-run</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OTELBOX_BIND_HOST</key>
        <string>127.0.0.1</string>
        <key>OTELBOX_HEALTH_ENDPOINT</key>
        <string>127.0.0.1:13133</string>
        <key>OTELBOX_STORAGE_DIR</key>
        <string>{{ ansible_facts['env']['HOME'] }}/.local/state/otelbox/edge</string>
        <key>OTELBOX_MEMORY_LIMIT_MIB</key>
        <string>2048</string>
        <key>OTELBOX_MEMORY_SPIKE_LIMIT_MIB</key>
        <string>512</string>
        <key>OTELBOX_EXPORTER_CONSUMERS</key>
        <string>2</string>
        <key>OTELBOX_AUTH_RETRY_INTERVAL</key>
        <string>1h</string>
        <!--
          Sized to hold a 72-hour gateway outage without loss. `sizer: bytes`
          counts UNCOMPRESSED proto, so the rate that matters is the
          uncompressed one: ~1.1-2.1 GiB/h of traces (the traces WAL crossed
          100 MiB about every 320 s), not the ~48 MB/h of compressed wire
          throughput an earlier sizing used. 72 h x 2 GiB/h = 144 GiB of queue;
          less the 768 MiB in-flight headroom under `batch` in edge.yaml it
          still covers ~71.6 h at that rate. Storage is 1.5 x queue = 216 GiB,
          the margin for bbolt page, freelist and churn overhead that keeps the
          queue, not the file, the limit that refuses admission. Both caps apply
          per signal file, and the WAL does not preallocate: disk is claimed
          only as a backlog grows. Keep in step with the validate task in
          install_otelbox_edge.yml.
        -->
        <key>OTELBOX_STORAGE_MAX_SIZE_BYTES</key>
        <string>231928233984</string>
        <key>OTELBOX_QUEUE_SIZE_BYTES</key>
        <string>154618822656</string>
        <!--
          The gateway leg's wire codec. zstd is upstream's 2.x default and is
          safe only while both ends of the leg are this same binary: a gRPC codec
          must be registered in the peer's build, not merely named in its
          configuration. A gateway still on 2.1.x needs gzip here. This is a
          plist key rather than a line in endpoint.env because that file is a
          strict one-line contract — the wrapper and the preflight awk both
          reject a second line.
        -->
        <key>OTELBOX_UPSTREAM_COMPRESSION</key>
        <string>{{ devbox_packages.otelbox_edge.upstream_compression | default('zstd') }}</string>
        <!--
          Stamped by transform/langfuse_native on native traces, so they share
          the user the Langfuse hooks already report.
        -->
        <key>OTELBOX_LANGFUSE_USER_ID</key>
        <string>{{ devbox_langfuse_user_id | e }}</string>
        <key>OTEL_RESOURCE_ATTRIBUTES</key>
        <string>deployment.environment.name={{ devbox_active_profile | default('personal') }}</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>{{ ansible_facts['env']['HOME'] }}/Library/Logs/otelbox-edge.log</string>

    <key>StandardErrorPath</key>
    <string>{{ ansible_facts['env']['HOME'] }}/Library/Logs/otelbox-edge.log</string>
</dict>
</plist>
