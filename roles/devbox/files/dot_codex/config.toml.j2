# Portable Codex settings and defaults owned by devbox-setup.
# scripts/ai-config reconciles these settings with ~/.codex/config.toml while
# preserving manifest-classified machine-local and runtime state.
# Model and reasoning effort are defaults because Codex persists local choices.

personality = "pragmatic"
model = "gpt-5.6-sol"
model_reasoning_effort = "medium"
service_tier = "default"
sandbox_mode = "workspace-write"


[sandbox_workspace_write]
network_access = true

[otel]
environment = "{{ devbox_active_profile }}"
log_user_prompt = true
exporter = { otlp-grpc = { endpoint = "http://127.0.0.1:4317" } }
trace_exporter = "none"
metrics_exporter = { otlp-grpc = { endpoint = "http://127.0.0.1:4317" } }
# Waiting on openai/codex#30987 — silently ignored until resource_attributes lands.
resource_attributes = { "otelbox.telemetry.class" = "llm" }


[tool_suggest]
disabled_tools = [{ id = "github@openai-curated-remote", type = "plugin" }]

[features]
hooks = true
js_repl = false
memories = true

[hooks]
Interrupt = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py Interrupt", type = "command" }] }]
PermissionRequest = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py PermissionRequest", type = "command" }] }]
PostCompact = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py PostCompact", type = "command" }] }]
PostToolUse = [{ hooks = [{ async = true, command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py PostToolUse", type = "command" }], matcher = ".*" }]
PreCompact = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py PreCompact", type = "command" }] }]
PreToolUse = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py PreToolUse", type = "command" }], matcher = ".*" }]
SessionEnd = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py SessionEnd", type = "command" }] }]
SessionStart = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py SessionStart", type = "command" }] }]
Stop = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py Stop", type = "command" }] }]
SubagentStart = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py SubagentStart", type = "command" }] }]
SubagentStop = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py SubagentStop", type = "command" }] }]
UserPromptSubmit = [{ hooks = [{ command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py UserPromptSubmit", type = "command" }] }]

[plugins]

[plugins."browser@openai-bundled"]
enabled = true

[plugins."codex-app-tools@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."sites@openai-bundled"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."superpowers@openai-curated"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[plugins."tracing@codex-observability-plugin"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true
