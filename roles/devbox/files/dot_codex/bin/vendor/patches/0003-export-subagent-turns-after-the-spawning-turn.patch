+type OtlpIdentifiedSpan = OtlpSpan & { traceId?: string; spanId?: string; parentSpanId?: string };
+
+function exportedSpans(bodies: string[]) {
+  return bodies
+    .flatMap((body) => (JSON.parse(body) as OtlpBody).resourceSpans ?? [])
+    .flatMap((resource) => resource.scopeSpans ?? [])
+    .flatMap((scope) => (scope.spans ?? []) as OtlpIdentifiedSpan[])
+    .map((span) => ({
+      name: span.name,
+      traceId: span.traceId ?? "",
+      spanId: span.spanId ?? "",
+      parentSpanId: span.parentSpanId ?? "",
+      attributes: Object.fromEntries(
+        (span.attributes ?? []).map(({ key, value }) => [
+          key,
+          String(value.stringValue ?? value.boolValue ?? value.intValue ?? ""),
+        ]),
+      ),
+    }));
+}
