{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dss_output.schema.json",
  "title": "DSS Output",
  "description": "Structured output for the Diverge-Synthesize-Select protocol. Records the problem statement, why the options threshold held, strategy axes, the 3-7 candidates shown in the decision card (including a boring baseline and at least one combination), evaluation, recommendation, and user selection.",
  "type": "object",
  "required": ["problem_statement", "complexity", "strategy_axes", "options", "evaluation", "recommendation", "selected"],
  "properties": {
    "problem_statement": {
      "type": "string",
      "description": "One-sentence description of the core design problem."
    },
    "complexity": {
      "type": "object",
      "required": ["threshold_triggers", "n_options", "sub_factors"],
      "properties": {
        "threshold_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["irreversible", "multi_component", "crosses_scope", "user_asked", "outcome_changing_unknowns"]
          },
          "description": "Which conditions of the options threshold held: irreversible or expensive to undo; touches several files, components, or services; crosses the named scope; the user asked for options; two or three unknowns could change the outcome substantially."
        },
        "n_options": {
          "type": "integer",
          "minimum": 3,
          "maximum": 7,
          "description": "Number of candidates generated and shown (3-7). Use the upper end when the choice is irreversible and several unknowns are in play."
        },
        "sub_factors": {
          "type": "object",
          "required": ["reversibility", "blast_radius", "novelty", "ambiguity"],
          "properties": {
            "reversibility": { "$ref": "#/$defs/sub_factor_level" },
            "blast_radius": { "$ref": "#/$defs/sub_factor_level" },
            "novelty": { "$ref": "#/$defs/sub_factor_level" },
            "ambiguity": { "$ref": "#/$defs/sub_factor_level" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "strategy_axes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "values"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the orthogonal dimension (e.g., 'data flow', 'coupling level')."
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" },
            "description": "Possible positions along this axis."
          }
        },
        "additionalProperties": false
      },
      "description": "Orthogonal dimensions identified before option generation. Each axis has 2+ possible values."
    },
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "allOf": [
        { "contains": { "properties": { "tag": { "const": "baseline" } } } },
        { "contains": { "properties": { "tag": { "const": "combination" } } } }
      ],
      "description": "Every candidate shown in the decision card. At least one boring baseline and at least one combination are required.",
      "items": {
        "type": "object",
        "required": ["id", "name", "tag", "axis_position", "summary"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OPT-[0-9]+$",
            "description": "Stable option identifier (e.g., OPT-1); always shown together with the name, never renumbered."
          },
          "name": {
            "type": "string",
            "description": "Short name for the option."
          },
          "tag": {
            "type": "string",
            "enum": ["baseline", "combination", "standard", "unconventional"],
            "description": "Candidate category. 'baseline' is the simplest thing that could work; 'combination' merges strengths of other candidates."
          },
          "axis_position": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Map of axis name to the value this option occupies on that axis."
          },
          "summary": {
            "type": "string",
            "description": "Mechanism: one-sentence summary of how the approach works."
          },
          "differentiator": {
            "type": "string",
            "description": "What makes this option genuinely different from others."
          },
          "pros": {
            "type": "array",
            "items": { "type": "string" }
          },
          "cons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "combines_with": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Option IDs whose strengths this candidate could absorb."
          },
          "source_options": {
            "type": "array",
            "items": { "type": "string" },
            "description": "For a combination: the option IDs it draws from."
          }
        },
        "additionalProperties": false
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["criteria", "candidates", "synthesis"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "weight"],
            "properties": {
              "name": { "type": "string" },
              "weight": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            },
            "additionalProperties": false
          },
          "description": "Evaluation criteria with weights. Must include simplicity, consistency, reversibility, testability at minimum."
        },
        "eliminated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["option_id", "reason"],
            "properties": {
              "option_id": { "type": "string" },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          },
          "description": "Options dropped, each with its reason; they still appear in the decision card marked 'dropped: <reason>'."
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "description": "Every candidate that survived elimination, scored — no top-N cap, because the user may know a constraint that makes a runner-up the right pick.",
          "items": {
            "type": "object",
            "required": ["option_id", "scores", "strengths", "weaknesses"],
            "properties": {
              "option_id": { "type": "string" },
              "scores": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "enum": ["strong", "adequate", "weak"]
                },
                "description": "Map of criterion name to score."
              },
              "strengths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "weaknesses": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "synthesis": {
          "type": "object",
          "required": ["synergies", "trade_offs"],
          "properties": {
            "synergies": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Which candidates reinforce each other and how."
            },
            "trade_offs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "What each direction gives up relative to the others."
            },
            "conflicts": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Incompatibilities that rule out further combinations."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "required": ["option_id", "reason"],
      "properties": {
        "option_id": {
          "type": "string",
          "pattern": "^OPT-[0-9]+$",
          "description": "The recommended candidate."
        },
        "reason": {
          "type": "string",
          "description": "Why it wins under the stated criteria, and what would change the recommendation."
        }
      },
      "additionalProperties": false
    },
    "selected": {
      "type": "object",
      "required": ["choice", "rationale", "decided_by"],
      "properties": {
        "choice": {
          "type": ["string", "null"],
          "description": "Option ID or 'custom', or null while the decision is pending."
        },
        "rationale": {
          "type": "string",
          "description": "Why this option was selected."
        },
        "decided_by": {
          "type": "string",
          "enum": ["user", "agent", "pending"],
          "description": "Who made the selection."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sub_factor_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  }
}
