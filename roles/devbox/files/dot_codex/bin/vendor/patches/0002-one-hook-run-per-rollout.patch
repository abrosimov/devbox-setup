diff --git a/plugins/tracing/src/sidecar.ts b/plugins/tracing/src/sidecar.ts
index c525379..1e4b548 100644
--- a/plugins/tracing/src/sidecar.ts
+++ b/plugins/tracing/src/sidecar.ts
@@ -1,3 +1,4 @@
+import { randomUUID } from "node:crypto";
 import * as fs from "node:fs/promises";
 
 /**
@@ -22,3 +23,96 @@ export async function markTurnUploaded(rolloutFile: string, turnId: string): Pro
     // Best-effort: a failed write only risks a duplicate upload next time.
   }
 }
+
+// Twice the longest hook budget (Stop, 30 s): no live hook run holds the lock this long.
+const ROLLOUT_LOCK_STALE_MS = 60_000;
+const ROLLOUT_LOCK_POLL_MS = 50;
+
+const errorCode = (error: unknown): string | undefined => (error as NodeJS.ErrnoException).code;
+
+async function readIfPresent(file: string): Promise<string | undefined> {
+  try {
+    return await fs.readFile(file, "utf-8");
+  } catch (error) {
+    if (errorCode(error) === "ENOENT") return undefined;
+    throw error;
+  }
+}
+
+async function unlinkIfPresent(file: string): Promise<void> {
+  try {
+    await fs.unlink(file);
+  } catch (error) {
+    if (errorCode(error) !== "ENOENT") throw error;
+  }
+}
+
+async function tryCreateLock(lockFile: string, token: string): Promise<boolean> {
+  const staged = `${lockFile}.${token}`;
+  await fs.writeFile(staged, token, { encoding: "utf-8", flag: "wx" });
+  try {
+    await fs.link(staged, lockFile);
+    return true;
+  } catch (error) {
+    if (errorCode(error) === "EEXIST") return false;
+    throw error;
+  } finally {
+    await unlinkIfPresent(staged);
+  }
+}
+
+async function takeOverIfStale(lockFile: string, token: string): Promise<void> {
+  let observed: string;
+  let ageMs: number;
+  try {
+    const handle = await fs.open(lockFile, "r");
+    try {
+      ageMs = Date.now() - (await handle.stat()).mtimeMs;
+      observed = await handle.readFile("utf-8");
+    } finally {
+      await handle.close();
+    }
+  } catch (error) {
+    if (errorCode(error) === "ENOENT") return;
+    throw error;
+  }
+  if (ageMs <= ROLLOUT_LOCK_STALE_MS) return;
+
+  const removed = `${lockFile}.stale.${token}`;
+  try {
+    await fs.rename(lockFile, removed);
+  } catch (error) {
+    if (errorCode(error) === "ENOENT") return;
+    throw error;
+  }
+  try {
+    if ((await readIfPresent(removed)) !== observed) {
+      // Another run replaced the stale lock first; put its live lock back.
+      await fs.link(removed, lockFile).catch((error: unknown) => {
+        if (errorCode(error) !== "EEXIST") throw error;
+      });
+    }
+  } finally {
+    await unlinkIfPresent(removed);
+  }
+}
+
+/** Resolves to `undefined` when another run still holds the lock after `waitMs`. */
+export async function acquireRolloutLock(
+  rolloutFile: string,
+  waitMs: number,
+): Promise<(() => Promise<void>) | undefined> {
+  const lockFile = `${rolloutFile}.langfuse.lock`;
+  const token = `${process.pid}-${randomUUID()}`;
+  const deadline = Date.now() + waitMs;
+  for (;;) {
+    if (await tryCreateLock(lockFile, token)) {
+      return async () => {
+        if ((await readIfPresent(lockFile)) === token) await unlinkIfPresent(lockFile);
+      };
+    }
+    await takeOverIfStale(lockFile, token);
+    if (Date.now() >= deadline) return undefined;
+    await new Promise((resolve) => setTimeout(resolve, ROLLOUT_LOCK_POLL_MS));
+  }
+}
