+
+import type { Config } from "../src/config.js";
+import { setupInstrumentation } from "../src/instrumentation.js";
+import { loadAbandonedTurnIds, recordExportFailure } from "../src/sidecar.js";
+import { convertRollout } from "../src/trace.js";
+
+const events = vi.hoisted((): string[] => []);
+
+vi.mock("node:fs/promises", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("node:fs/promises")>();
+  const open: typeof actual.open = async (file, ...rest) => {
+    const handle = await actual.open(file, ...rest);
+    const sync = handle.sync.bind(handle);
+    handle.sync = async () => {
+      await sync();
+      events.push(`sync ${String(file)}`);
+    };
+    return handle;
+  };
+  return { ...actual, default: { ...actual, open }, open };
+});
+
+const tmpDirs: string[] = [];
+
+afterEach(() => {
+  events.length = 0;
+  vi.restoreAllMocks();
+  while (tmpDirs.length) fs.rmSync(tmpDirs.pop()!, { recursive: true, force: true });
+});
+
+function makeTempDir(prefix: string): string {
+  const dir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)));
+  tmpDirs.push(dir);
+  return dir;
+}
+
+async function closedPortUrl(): Promise<string> {
+  const server = http.createServer();
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const { port } = server.address() as { port: number };
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+  return `http://127.0.0.1:${port}`;
+}
+
+function writeRollout(turnIds: string[]): string {
+  const day = path.join(makeTempDir("lf-codex-spool-"), "sessions", "2026", "06", "03");
+  fs.mkdirSync(day, { recursive: true });
+  const line = (type: string, payload: Record<string, unknown>) =>
+    JSON.stringify({ timestamp: "2026-06-03T12:00:00.000Z", type, payload });
+  const lines = [line("session_meta", { id: "sess-spool", cli_version: "0.163.0" })];
+  for (const id of turnIds) {
+    lines.push(
+      line("event_msg", { type: "task_started", turn_id: id }),
+      line("event_msg", { type: "user_message", message: `Prompt of ${id}` }),
+      line("event_msg", { type: "agent_message", message: `Answer to ${id}` }),
+      line("event_msg", { type: "task_complete", turn_id: id }),
+    );
+  }
+  const rollout = path.join(day, "rollout-spool.jsonl");
+  fs.writeFileSync(rollout, lines.join("\n") + "\n");
+  return rollout;
+}
+
+const configFor = (baseUrl: string): Config => ({
+  enabled: true,
+  public_key: "pk-lf-test",
+  secret_key: "sk-lf-test",
+  base_url: baseUrl,
+  skill_tags: true,
+  max_history_chars: 200_000,
+  debug: false,
+  fail_on_error: false,
+});
+
+const committed = (spool: string): string[] =>
+  fs.existsSync(spool) ? fs.readdirSync(spool).filter((name) => name.endsWith(".otlp")) : [];
+
+async function exportWhileEdgeIsDown(
+  limits: { maxSpoolBytes?: number } = {},
+): Promise<{ spool: string; marked: string[]; failure: unknown }> {
+  const spool = path.join(makeTempDir("lf-codex-state-"), "langfuse_otlp_spool");
+  const config = configFor(await closedPortUrl());
+  const instrumentation = setupInstrumentation(config, { spoolDirectory: spool, ...limits });
+  const marked: string[] = [];
+  let failure: unknown;
+  await convertRollout(writeRollout(["turn-1", "turn-2"]), {
+    config,
+    stoppedTurnId: "turn-2",
+    onTurnExported: async (turnId) => {
+      await instrumentation.flush();
+      events.push(`mark ${turnId}`);
+      marked.push(turnId);
+    },
+  }).catch((error: unknown) => {
+    failure = error;
+  });
+  await instrumentation.shutdown().catch(() => undefined);
+  return { spool, marked, failure };
+}
+
+describe("the OTLP spool a turn is marked against", () => {
+  it("fsyncs each request and the spool directory before the turn is marked", async () => {
+    vi.spyOn(process.stderr, "write").mockImplementation(() => true);
+
+    const { spool, marked } = await exportWhileEdgeIsDown();
+
+    expect(marked).toEqual(["turn-1", "turn-2"]);
+    const entries = committed(spool);
+    expect(entries.length).toBeGreaterThanOrEqual(2);
+    const lastMark = events.lastIndexOf("mark turn-2");
+    for (const name of entries) {
+      const fileSync = events.findIndex((e) => e.endsWith(`/.${name.replace(/\.otlp$/, "")}.tmp`));
+      expect(fileSync, `no fsync of ${name} before it was committed`).toBeGreaterThanOrEqual(0);
+      expect(fileSync).toBeLessThan(lastMark);
+    }
+    const directorySyncs = events
+      .map((e, index) => (e === `sync ${spool}` ? index : -1))
+      .filter((index) => index >= 0);
+    const firstMark = events.indexOf("mark turn-1");
+    expect(directorySyncs.some((index) => index < firstMark)).toBe(true);
+    expect(directorySyncs.some((index) => index > firstMark && index < lastMark)).toBe(true);
+  });
+
+  it("refuses a request that would take the spool past its cap, and marks nothing", async () => {
+    const stderr = vi.spyOn(process.stderr, "write").mockImplementation(() => true);
+
+    const { spool, marked, failure } = await exportWhileEdgeIsDown({ maxSpoolBytes: 64 });
+
+    expect(marked).toEqual([]);
+    expect(committed(spool)).toEqual([]);
+    expect(String(failure)).toContain("spool full");
+    const alerts = stderr.mock.calls.map(([chunk]) => String(chunk));
+    expect(alerts.some((line) => line.includes(spool) && line.includes("64"))).toBe(true);
+  });
+});
+
+describe("export failures recorded in the sidecar", () => {
+  it("gives a turn up after three failed runs, and at once when it was rejected", async () => {
+    const rollout = path.join(makeTempDir("lf-codex-failures-"), "rollout.jsonl");
+
+    for (let run = 1; run <= 3; run++) {
+      expect(await recordExportFailure(rollout, "turn-failing", "failed", "HTTP 500")).toBe(
+        run === 3,
+      );
+    }
+    expect(await recordExportFailure(rollout, "turn-rejected", "rejected", "HTTP 400")).toBe(true);
+
+    expect([...(await loadAbandonedTurnIds(rollout))].sort()).toEqual([
+      "turn-failing",
+      "turn-rejected",
+    ]);
+  });
+});
