+
+describe("one hook run at a time per rollout", () => {
+  const event = (ts: string, payload: Record<string, unknown>) =>
+    JSON.stringify({ timestamp: ts, type: "event_msg", payload });
+
+  function stageTwoTurnRollout(sessionId: string): string {
+    const sessionsDir = path.join(
+      makeTempDir("lf-codex-sessions-"),
+      "sessions",
+      "2026",
+      "06",
+      "03",
+    );
+    fs.mkdirSync(sessionsDir, { recursive: true });
+    const rollout = path.join(sessionsDir, "rollout.jsonl");
+    fs.writeFileSync(
+      rollout,
+      [
+        JSON.stringify({
+          timestamp: "2026-06-03T12:00:00.000Z",
+          type: "session_meta",
+          payload: { id: sessionId, cli_version: "0.160.1" },
+        }),
+        event("2026-06-03T12:00:01.000Z", { type: "task_started", turn_id: "turn-1" }),
+        event("2026-06-03T12:00:01.100Z", { type: "user_message", message: "First" }),
+        event("2026-06-03T12:00:02.000Z", { type: "agent_message", message: "One" }),
+        event("2026-06-03T12:00:02.100Z", { type: "task_complete", turn_id: "turn-1" }),
+        event("2026-06-03T12:01:00.000Z", { type: "task_started", turn_id: "turn-2" }),
+        event("2026-06-03T12:01:00.100Z", { type: "user_message", message: "Second" }),
+        event("2026-06-03T12:01:01.000Z", { type: "agent_message", message: "Two" }),
+      ].join("\n") + "\n",
+    );
+    return rollout;
+  }
+
+  async function withSlowCollector(
+    responseDelayMs: number,
+    run: (
+      hook: (payload: Record<string, unknown>) => Promise<number>,
+      bodies: string[],
+    ) => Promise<void>,
+  ): Promise<void> {
+    const codexHome = makeTempDir("lf-codex-home-");
+    const sessionCwd = makeTempDir("lf-codex-cwd-");
+    const bodies: string[] = [];
+    const server = http.createServer((req, res) => {
+      const chunks: Buffer[] = [];
+      req.on("data", (chunk) => chunks.push(chunk as Buffer));
+      req.on("end", () => {
+        bodies.push(Buffer.concat(chunks).toString("utf-8"));
+        setTimeout(() => {
+          res.writeHead(200, { "content-type": "application/json" });
+          res.end("{}");
+        }, responseDelayMs);
+      });
+    });
+    await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+    const { port } = server.address() as { port: number };
+
+    const hook = async (payload: Record<string, unknown>): Promise<number> => {
+      const started = Date.now();
+      const { code } = await runShellCommand(readHookCommand(), {
+        cwd: sessionCwd,
+        env: {
+          ...process.env,
+          PLUGIN_ROOT: pluginRootDir,
+          CODEX_HOME: codexHome,
+          HOME: codexHome,
+          TRACE_TO_LANGFUSE: "true",
+          LANGFUSE_PUBLIC_KEY: "pk-lf-test",
+          LANGFUSE_SECRET_KEY: "sk-lf-test",
+          LANGFUSE_BASE_URL: `http://127.0.0.1:${port}`,
+        },
+        input: JSON.stringify(payload),
+      });
+      expect(code).toBe(0);
+      return Date.now() - started;
+    };
+
+    try {
+      await run(hook, bodies);
+    } finally {
+      await new Promise<void>((resolve) => server.close(() => resolve()));
+    }
+  }
+
+  const exportCounts = (bodies: string[]): Record<string, number> => {
+    const counts: Record<string, number> = {};
+    for (const root of exportedTurnRoots(bodies)) {
+      const turnId = root["langfuse.observation.metadata.codex.turn_id"];
+      counts[turnId] = (counts[turnId] ?? 0) + 1;
+    }
+    return counts;
+  };
+
+  const sidecar = (rollout: string): string[] =>
+    fs.existsSync(`${rollout}.langfuse`)
+      ? fs.readFileSync(`${rollout}.langfuse`, "utf-8").split("\n").filter(Boolean)
+      : [];
+
+  it("exports each turn exactly once when two runs start together", async () => {
+    const rollout = stageTwoTurnRollout("sess-concurrent");
+    const stop = {
+      hook_event_name: "Stop",
+      session_id: "sess-concurrent",
+      turn_id: "turn-2",
+      transcript_path: rollout,
+    };
+
+    await withSlowCollector(300, async (hook, bodies) => {
+      await Promise.all([hook(stop), hook({ ...stop, hook_event_name: "Interrupt" })]);
+
+      expect(exportCounts(bodies)).toEqual({ "turn-1": 1, "turn-2": 1 });
+      expect(sidecar(rollout).sort()).toEqual(["turn-1", "turn-2"]);
+      expect(fs.existsSync(`${rollout}.langfuse.lock`)).toBe(false);
+    });
+  });
+
+  it("takes over a lock older than the staleness timeout", async () => {
+    const rollout = stageTwoTurnRollout("sess-stale");
+    const lock = `${rollout}.langfuse.lock`;
+    fs.writeFileSync(lock, "99999-crashed-holder");
+    const twoMinutesAgo = new Date(Date.now() - 120_000);
+    fs.utimesSync(lock, twoMinutesAgo, twoMinutesAgo);
+
+    await withSlowCollector(0, async (hook, bodies) => {
+      await hook({
+        hook_event_name: "Stop",
+        session_id: "sess-stale",
+        turn_id: "turn-2",
+        transcript_path: rollout,
+      });
+
+      expect(exportCounts(bodies)).toEqual({ "turn-1": 1, "turn-2": 1 });
+      expect(sidecar(rollout)).toEqual(["turn-1", "turn-2"]);
+      expect(fs.existsSync(lock)).toBe(false);
+    });
+  });
+
+  it("exits without exporting while another run holds the lock", async () => {
+    const rollout = stageTwoTurnRollout("sess-held");
+    const lock = `${rollout}.langfuse.lock`;
+    fs.writeFileSync(lock, "1-live-holder");
+
+    await withSlowCollector(0, async (hook, bodies) => {
+      const elapsedMs = await hook({
+        hook_event_name: "SessionEnd",
+        session_id: "sess-held",
+        transcript_path: rollout,
+      });
+
+      expect(exportCounts(bodies)).toEqual({});
+      expect(sidecar(rollout)).toEqual([]);
+      expect(fs.readFileSync(lock, "utf-8")).toBe("1-live-holder");
+      expect(elapsedMs).toBeLessThan(3_000);
+    });
+  });
+});
