# Portable Codex settings owned by devbox-setup as the source of truth.
# scripts/ai-config reconciles these settings with ~/.codex/config.toml while
# preserving manifest-classified machine-local and runtime state.

personality = "pragmatic"
model = "gpt-5.6-sol"
model_reasoning_effort = "high"
service_tier = "default"
sandbox_mode = "workspace-write"

[features]
memories = true
hooks = true

[sandbox_workspace_write]
network_access = true

[otel]
environment = "{{ devbox_active_profile }}"
log_user_prompt = true
exporter = { otlp-grpc = { endpoint = "http://127.0.0.1:4317" } }
trace_exporter = "none"
metrics_exporter = { otlp-grpc = { endpoint = "http://127.0.0.1:4317" } }
# Waiting on openai/codex#30987 — silently ignored until resource_attributes lands.
resource_attributes = { "otelbox.telemetry.class" = "llm" }

[[hooks.PreToolUse]]
matcher = ".*"
[[hooks.PreToolUse.hooks]]
type = "command"
command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py PreToolUse"

[[hooks.PostToolUse]]
matcher = ".*"
[[hooks.PostToolUse.hooks]]
type = "command"
command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py PostToolUse"
async = true

[[hooks.PreCompact]]
[[hooks.PreCompact.hooks]]
type = "command"
command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py PreCompact"

[[hooks.Stop]]
[[hooks.Stop.hooks]]
type = "command"
command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py Stop"

[[hooks.SessionStart]]
[[hooks.SessionStart.hooks]]
type = "command"
command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py SessionStart"

[[hooks.SessionEnd]]
[[hooks.SessionEnd.hooks]]
type = "command"
command = "~/.codex/bin/.venv/bin/python ~/.codex/bin/universal_logger.py SessionEnd"

[plugins]

[plugins."browser@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."sites@openai-bundled"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."superpowers@openai-curated"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."tracing@codex-observability-plugin"]
enabled = true

[tool_suggest]
disabled_tools = [{ id = "github@openai-curated-remote", type = "plugin" }]
