#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "usage: with-anthropic-wif COMMAND [ARG ...]" >&2
    exit 2
fi

: "${ANTHROPIC_IDENTITY_TOKEN_FILE:?Run the Configure Anthropic WIF action first}"

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
refresh_command="${script_dir}/refresh-anthropic-identity-token"

# Static credentials and active profiles have higher precedence than WIF.
# Remove them only from this child-process boundary.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_PROFILE

"$refresh_command" "$ANTHROPIC_IDENTITY_TOKEN_FILE"
(
    while sleep 180; do
        "$refresh_command" "$ANTHROPIC_IDENTITY_TOKEN_FILE" \
            || echo "warning: could not refresh the Anthropic identity token" >&2
    done
) &
refresh_pid=$!

cleanup() {
    kill "$refresh_pid" 2>/dev/null || true
    wait "$refresh_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

set +e
"$@"
status=$?
set -e

exit "$status"
