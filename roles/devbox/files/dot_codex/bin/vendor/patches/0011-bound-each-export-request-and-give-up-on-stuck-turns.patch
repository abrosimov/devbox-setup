+const FAILED_RUNS_BEFORE_GIVING_UP = 3;
+
+export type RecordedFailure = "rejected" | "failed";
+
+const failuresFile = (rolloutFile: string) => `${rolloutFile}.langfuse-failures`;
+
+/** Turns no later run exports: rejected once, or failed in `FAILED_RUNS_BEFORE_GIVING_UP` runs. */
+export async function loadAbandonedTurnIds(rolloutFile: string): Promise<Set<string>> {
+  const failedRuns = new Map<string, number>();
+  const abandoned = new Set<string>();
+  for (const line of ((await readIfPresent(failuresFile(rolloutFile))) ?? "").split("\n")) {
+    const [turnId, kind] = line.split("\t");
+    if (!turnId) continue;
+    const runs = (failedRuns.get(turnId) ?? 0) + 1;
+    failedRuns.set(turnId, runs);
+    if (kind === "rejected" || runs >= FAILED_RUNS_BEFORE_GIVING_UP) abandoned.add(turnId);
+  }
+  return abandoned;
+}
+
+export async function loadSettledTurnIds(rolloutFile: string): Promise<Set<string>> {
+  const settled = await loadUploadedTurnIds(rolloutFile);
+  for (const turnId of await loadAbandonedTurnIds(rolloutFile)) settled.add(turnId);
+  return settled;
+}
+
+/** Resolves to whether the turn is now abandoned; a failed write leaves it to be retried. */
+export async function recordExportFailure(
+  rolloutFile: string,
+  turnId: string,
+  kind: RecordedFailure,
+  reason: string,
+): Promise<boolean> {
+  const line = [turnId, kind, new Date().toISOString(), reason.replace(/\s+/g, " ")].join("\t");
+  try {
+    await fs.appendFile(failuresFile(rolloutFile), `${line}\n`, "utf-8");
+  } catch {
+    return false;
+  }
+  return (await loadAbandonedTurnIds(rolloutFile)).has(turnId);
+}
+
 // Twice the longest hook budget (Stop, 30 s): no live hook run holds the lock this long.
 const ROLLOUT_LOCK_STALE_MS = 60_000;
 const ROLLOUT_LOCK_POLL_MS = 50;
