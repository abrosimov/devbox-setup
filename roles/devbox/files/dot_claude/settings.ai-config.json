{
  "schema_version": 1,
  "engine": "claude",
  "fields": [
    {
      "path": "attribution",
      "scope": "shared"
    },
    {
      "path": "autoMemoryEnabled",
      "scope": "shared"
    },
    {
      "path": "cleanupPeriodDays",
      "scope": "preference",
      "preference": {
        "type": "integer",
        "minimum": 1
      }
    },
    {
      "path": "dialogExpiry",
      "scope": "preference"
    },
    {
      "path": "enabledPlugins",
      "scope": "shared"
    },
    {
      "path": "env",
      "scope": "shared"
    },
    {
      "path": "env.LANGFUSE_PUBLIC_KEY",
      "scope": "environment",
      "binding": "keychain:devbox-langfuse/public-key",
      "secret": true
    },
    {
      "path": "env.LANGFUSE_SECRET_KEY",
      "scope": "environment",
      "binding": "keychain:devbox-langfuse/secret-key",
      "secret": true
    },
    {
      "path": "extraKnownMarketplaces",
      "scope": "shared"
    },
    {
      "path": "hooks",
      "scope": "shared"
    },
    {
      "path": "model",
      "scope": "shared"
    },
    {
      "path": "permissions",
      "scope": "shared"
    },
    {
      "path": "permissions.allow",
      "scope": "shared",
      "strategy": "ordered-set"
    },
    {
      "path": "permissions.deny",
      "scope": "shared",
      "strategy": "ordered-set"
    },
    {
      "path": "permissions.additionalDirectories",
      "scope": "shared",
      "strategy": "ordered-set"
    },
    {
      "path": "sandbox",
      "scope": "shared"
    },
    {
      "path": "skipAutoPermissionPrompt",
      "scope": "shared"
    },
    {
      "path": "skipWorkflowUsageWarning",
      "scope": "runtime"
    },
    {
      "path": "statusLine",
      "scope": "shared"
    },
    {
      "path": "tui",
      "scope": "shared"
    }
  ]
}
