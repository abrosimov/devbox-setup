# Example ONLY — the real file is machine-local and gitignored.
#
# Put the real one in the local overlay so it deploys to
# ~/.config/drive-backup/config.toml:
#
#   roles/devbox/local/.config/drive-backup/config.toml
#
# Its presence is the switch: with it, `make personal`/`make work` installs the
# weekly `local.drive-backup` LaunchAgent (Friday→Saturday night); without it, the
# playbook removes the agent. Check a draft with
#   ~/.local/share/drive-backup/.venv/bin/drive-backup --config <file> check-config
#
# Paths: `~`, `$VARS`, or relative to $AION_AUTOPOIESEON. Archives land in
# <repo_dir>/<YYYY-MM>/<profile>_<name>_<YYYY-MM-DD>.tar.zst with the profile
# taken from $MNEMOSYNE_PERISTASEOS; an archive larger than max_part_bytes is
# written as .tar.zst.part-001, .part-002, … instead.
# Full reference: packages/drive-backup/README.md.

# repo_dir = "drive/base"     # default: $AION_AUTOPOIESEON/drive/base
# zstd_level = 9
# max_part_bytes = 1992294400 # default 1900 MiB; at most 2147483648 (GitHub LFS limit)

[[dir]]
name = "claude"
path = "~/.claude"
exclude = [
    "bin/.venv",
    "plugins/cache",
    "shell-snapshots",
    "statsig",
    "**/__pycache__",
]

[[dir]]
name = "codex"
path = "~/.codex"
exclude = ["**/__pycache__", "bin/.venv"]

[[dir]]
name = "gemini"
path = "~/.gemini"

# [[dir]]
# name = "notes"
# path = "notes/obsidian"     # → $AION_AUTOPOIESEON/notes/obsidian
# exclude = [".obsidian/workspace.json", ".trash"]
