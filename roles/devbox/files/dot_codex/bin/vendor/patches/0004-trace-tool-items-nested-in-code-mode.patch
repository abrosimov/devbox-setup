+
+function finiteOr(value: number | undefined, fallback: number): number {
+  return typeof value === "number" && Number.isFinite(value) ? value : fallback;
+}
+
+function mcpItemError(item: ThreadItem): string | undefined {
+  const { error, result } = item;
+  if (typeof error === "string" && error) return error;
+  if (error != null && typeof error === "object") {
+    const message = (error as { message?: unknown }).message;
+    return typeof message === "string" && message ? message : JSON.stringify(error);
+  }
+  if (result == null || typeof result !== "object") return undefined;
+  const { structuredContent, content } = result as {
+    structuredContent?: { error?: unknown } | null;
+    content?: MessageContentPart[];
+  };
+  if (typeof structuredContent?.error === "string" && structuredContent.error) {
+    return structuredContent.error;
+  }
+  return extractMessageText(content) || undefined;
+}
+
+function toolItemError(item: ThreadItem): string | undefined {
+  if (item.status !== "failed" && item.status !== "declined") return undefined;
+  if (item.type === "CommandExecution") {
+    return typeof item.exit_code === "number"
+      ? `Exit code: ${item.exit_code}`
+      : `Command ${item.status}`;
+  }
+  if (item.type === "McpToolCall") return mcpItemError(item) ?? `MCP tool call ${item.status}`;
+  return item.stderr || `${item.type} ${item.status}`;
+}
+
+function toolItemCall(
+  item: ThreadItem,
+  payload: EventMsgPayload,
+  ts: number,
+): ToolCall | undefined {
+  if (typeof item.id !== "string" || !item.id) return undefined;
+  if (item.source === "user_shell") return undefined;
+  const startTime = finiteOr(payload.started_at_ms, ts);
+  const call = {
+    callId: item.id,
+    startTime,
+    endTime: Math.max(startTime, finiteOr(payload.completed_at_ms, ts)),
+    error: toolItemError(item),
+  };
+  switch (item.type) {
+    case "CommandExecution":
+      return {
+        ...call,
+        name: "exec_command",
+        args: { command: item.command, cwd: item.cwd },
+        output: item.aggregated_output ?? undefined,
+      };
+    case "McpToolCall":
+      if (typeof item.server !== "string" || typeof item.tool !== "string") return undefined;
+      return {
+        ...call,
+        name: `${item.server}.${item.tool}`,
+        args: item.arguments,
+        output: item.result ?? undefined,
+        mcp: { server: item.server, tool: item.tool },
+      };
+    case "FileChange":
+      return { ...call, name: "apply_patch", args: { changes: item.changes }, output: item.stdout };
+    default:
+      return {
+        ...call,
+        name: item.kind || "extension",
+        args: Object.fromEntries(
+          Object.entries(item).filter(([key]) => !EXTENSION_ITEM_ENVELOPE.has(key)),
+        ),
+        output: item.results,
+      };
+  }
+}
