# Example ONLY — the real file is machine-local and gitignored.
#
# Put the real one in the local overlay so it deploys to
# ~/.config/otelbox/tunnel.env, where the `otelbox` fish function reads it:
#
#   roles/devbox/local/.config/otelbox/tunnel.env
#
# Deploy it with `make local-push` (or any full `make personal` / `make work`).
#
# It carries the SSH destination of the telemetry host and, optionally, the
# loopback ports its browser UIs listen on. Nothing here is secret, but the
# address of a private host does not belong in a public repository. No
# credentials live here — SSH authenticates with the key in the agent.
OTELBOX_TUNNEL_HOST=user@telemetry.example.com

# Defaults if omitted. They must match the server-side loopback publications
# (SigNoz and ClickStack in the remote_server_setup telemetry roles).
#OTELBOX_SIGNOZ_PORT=18080
#OTELBOX_CLICKSTACK_PORT=28080
