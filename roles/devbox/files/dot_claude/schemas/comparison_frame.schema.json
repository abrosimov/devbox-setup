{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comparison_frame.schema.json",
  "title": "Comparison Frame",
  "description": "Machine-readable record of a comparison frame built by the comparison-frame skill: the evaluated kind and use, the contrast cases, one scale per coordinate with its role, the comparator and basis, the stop condition, and the result rows. Tables and decision cards are renderings of this record.",
  "type": "object",
  "required": ["version", "evaluated", "contrast_cases", "coordinates", "comparator", "basis", "stop"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "evaluated": {
      "type": "object",
      "required": ["kind", "nature", "use", "judged_by"],
      "properties": {
        "kind": { "type": "string", "description": "What is being compared, as a kind: 'a gate run of one directory by one release on one runner'." },
        "nature": { "type": "string", "enum": ["system", "episteme", "work", "method", "relation"], "description": "FPF nature of the evaluated kind: an acting system, a claim-bearing description (model, spec, design), a performed occurrence (a run, a measurement), a reusable way of doing, or a relation." },
        "use": { "type": "string", "description": "The decision or action the comparison serves." },
        "judged_by": { "type": "string" },
        "window": { "type": "string", "description": "How long a result stays valid: 'until the pins or the runner change'." }
      },
      "additionalProperties": false
    },
    "contrast_cases": {
      "type": "object",
      "required": ["admissible", "below_floor", "outside_kind"],
      "properties": {
        "admissible": { "type": "string" },
        "below_floor": { "type": "string" },
        "outside_kind": { "type": "string", "description": "A candidate that must be refused, not scored." }
      },
      "additionalProperties": false
    },
    "coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "characteristic", "scale", "role", "is_measurement", "missing_means"],
        "properties": {
          "id": { "type": "string", "pattern": "^C-[0-9]+$" },
          "characteristic": { "type": "string", "description": "What is measured or judged (A.17), named from a failure mode." },
          "scale": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "enum": ["nominal", "ordinal", "interval", "ratio"] },
              "values": { "type": "array", "items": { "type": "string" }, "description": "Admissible values with their order for nominal and ordinal scales." },
              "unit": { "type": "string" },
              "value_meanings": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "is_measurement": { "type": "boolean", "description": "true for a measured value, false for a content judgement." },
          "measurement": {
            "type": "object",
            "description": "Required when is_measurement is true (C.16).",
            "required": ["measurand", "method", "conditions", "uncertainty", "validity_window"],
            "properties": {
              "measurand": { "type": "string" },
              "method": { "type": "string" },
              "conditions": { "type": "array", "items": { "type": "string" }, "description": "What the value depends on: hardware, versions, seeds, data." },
              "uncertainty": { "type": "string", "description": "How variance is handled: 'larger of two runs'." },
              "validity_window": { "type": "string" }
            },
            "additionalProperties": false
          },
          "missing_means": { "type": "string", "description": "What an absent value means: unchecked, not applicable, refused." },
          "role": { "type": "string", "enum": ["floor", "budget", "optimised", "orientation"] },
          "floor": { "type": "string", "description": "The value or condition that must be met (role floor)." },
          "limit": { "type": "string", "description": "The limit from the use (role budget)." },
          "direction": { "type": "string", "enum": ["lower", "higher", "none"], "description": "Preferred movement (role optimised); none for floors and orientation." },
          "protected_tradeoffs": { "type": "array", "items": { "type": "string", "pattern": "^C-[0-9]+$" }, "description": "Coordinates that may silently worsen while this one improves." }
        },
        "additionalProperties": false
      }
    },
    "comparator": {
      "type": "object",
      "required": ["role_order", "tie_rule", "aggregation"],
      "properties": {
        "role_order": { "type": "array", "items": { "type": "string", "enum": ["floor", "budget", "optimised"] } },
        "tie_rule": { "type": "string" },
        "aggregation": { "type": "string", "enum": ["none", "declared_index"], "description": "none: set-valued outcome over primitive coordinates; declared_index: weights published below, primitives kept." },
        "index_weights": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "basis": {
      "type": "object",
      "description": "The conditions all compared values share; a change of any field is a new basis.",
      "additionalProperties": { "type": "string" }
    },
    "stop": {
      "type": "object",
      "required": ["done_when", "reopen_when"],
      "properties": {
        "done_when": { "type": "string" },
        "reopen_when": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "description": "The option's stable id, OPT-n when it comes from DSS." },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate", "coordinate", "value", "basis_ref", "evidence", "rationale"],
        "properties": {
          "candidate": { "type": "string" },
          "coordinate": { "type": "string", "pattern": "^C-[0-9]+$" },
          "value": { "type": ["string", "number", "null"], "description": "null when missing; missing_means of the coordinate applies." },
          "basis_ref": { "type": "string", "description": "Identifier of the basis the value was taken on." },
          "evidence": { "type": "string", "description": "Locator: path:line, run id, document and edition." },
          "rationale": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "array",
      "description": "Set-valued comparison outcome per pair.",
      "items": {
        "type": "object",
        "required": ["a", "b", "relation"],
        "properties": {
          "a": { "type": "string" },
          "b": { "type": "string" },
          "relation": { "type": "string", "enum": ["a_dominates", "b_dominates", "incomparable", "a_below_floor", "b_below_floor", "basis_differs"] },
          "on": { "type": "array", "items": { "type": "string", "pattern": "^C-[0-9]+$" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
