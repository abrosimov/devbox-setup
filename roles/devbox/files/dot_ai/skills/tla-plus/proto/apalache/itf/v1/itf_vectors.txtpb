# Conformance vectors for the ITF converter, as apalache.itf.v1.ConformanceVectors.
# Written from Apalache ADR-015; the first real run of the pinned Apalache replaces
# the json of the first vector with the tool's own file and records the version here.

itf {
  note: "safety counterexample: a set, a sequence, an integer, varTypes"
  json: "{\"#meta\":{\"format\":\"ITF\",\"source\":\"ApaOrders.tla\",\"varTypes\":{\"orders\":\"Str -> Seq(Int)\",\"payments\":\"Set(Str)\"}},\"vars\":[\"orders\",\"payments\"],\"states\":[{\"#meta\":{\"index\":0},\"orders\":{\"#map\":[[\"c1\",[]]]},\"payments\":{\"#set\":[]}},{\"#meta\":{\"index\":1},\"orders\":{\"#map\":[[\"c1\",[{\"#bigint\":\"1\"}]]]},\"payments\":{\"#set\":[\"c1\"]}}]}"
  valid: true
  parsed {
    meta {
      format: "ITF"
      source: "ApaOrders.tla"
      var_types { key: "orders" value: "Str -> Seq(Int)" }
      var_types { key: "payments" value: "Set(Str)" }
    }
    vars: "orders"
    vars: "payments"
    states {
      index: 0
      vars { key: "orders" value { map_value { entries { key { string_value: "c1" } value { seq_value {} } } } } }
      vars { key: "payments" value { set_value {} } }
    }
    states {
      index: 1
      vars { key: "orders" value { map_value { entries { key { string_value: "c1" } value { seq_value { items { int_value: 1 } } } } } } }
      vars { key: "payments" value { set_value { items { string_value: "c1" } } } }
    }
  }
}
# "#meta" inside a state is optional.
itf {
  note: "state without #meta is valid; index stays unset"
  json: "{\"#meta\":{\"format\":\"ITF\"},\"vars\":[\"x\"],\"states\":[{\"x\":{\"#bigint\":\"1\"}}]}"
  valid: true
  parsed {
    meta { format: "ITF" }
    vars: "x"
    states { vars { key: "x" value { int_value: 1 } } }
  }
}
# A "#"-key the grammar does not define is rejected rather than guessed.
itf {
  note: "unknown #-key is rejected"
  json: "{\"#meta\":{\"format\":\"ITF\"},\"vars\":[\"x\"],\"states\":[{\"#meta\":{\"index\":0},\"x\":{\"#seq\":[1]}}]}"
  valid: false
}
