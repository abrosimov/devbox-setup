# Portable Codex settings owned by devbox-setup as the source of truth.
# scripts/ai-config reconciles these settings with ~/.codex/config.toml while
# preserving manifest-classified machine-local and runtime state.

personality = "pragmatic"
model = "gpt-5.6-sol"
model_reasoning_effort = "xhigh"
service_tier = "default"
sandbox_mode = "workspace-write"

[features]
memories = true
hooks = true

[sandbox_workspace_write]
network_access = true

[otel]
environment = "{{ devbox_active_profile }}"
log_user_prompt = true
exporter = { otlp-grpc = { endpoint = "http://127.0.0.1:4317" } }
trace_exporter = { otlp-grpc = { endpoint = "http://127.0.0.1:4317" } }
metrics_exporter = { otlp-grpc = { endpoint = "http://127.0.0.1:4317" } }

[[hooks.PreToolUse]]
matcher = ".*"
[[hooks.PreToolUse.hooks]]
type = "command"
command = "/usr/bin/env python3 {{ lookup('env', 'HOME') }}/.codex/bin/universal_logger.py PreToolUse"

[[hooks.PostToolUse]]
matcher = ".*"
[[hooks.PostToolUse.hooks]]
type = "command"
command = "/usr/bin/env python3 {{ lookup('env', 'HOME') }}/.codex/bin/universal_logger.py PostToolUse"
async = true

[[hooks.PreCompact]]
[[hooks.PreCompact.hooks]]
type = "command"
command = "/usr/bin/env python3 {{ lookup('env', 'HOME') }}/.codex/bin/universal_logger.py PreCompact"

[[hooks.Stop]]
[[hooks.Stop.hooks]]
type = "command"
command = "/usr/bin/env python3 {{ lookup('env', 'HOME') }}/.codex/bin/universal_logger.py Stop"

[[hooks.SessionStart]]
[[hooks.SessionStart.hooks]]
type = "command"
command = "/usr/bin/env python3 {{ lookup('env', 'HOME') }}/.codex/bin/universal_logger.py SessionStart"

[[hooks.SessionEnd]]
[[hooks.SessionEnd.hooks]]
type = "command"
command = "/usr/bin/env python3 {{ lookup('env', 'HOME') }}/.codex/bin/universal_logger.py SessionEnd"

[[hooks.WorktreeCreate]]
[[hooks.WorktreeCreate.hooks]]
type = "command"
command = "/usr/bin/env python3 {{ lookup('env', 'HOME') }}/.codex/bin/universal_logger.py WorktreeCreate"

[[hooks.WorktreeRemove]]
[[hooks.WorktreeRemove.hooks]]
type = "command"
command = "/usr/bin/env python3 {{ lookup('env', 'HOME') }}/.codex/bin/universal_logger.py WorktreeRemove"
