diff --git a/plugins/tracing/test/hook-command.test.ts b/plugins/tracing/test/hook-command.test.ts
index f68cb9c..32e90f7 100644
--- a/plugins/tracing/test/hook-command.test.ts
+++ b/plugins/tracing/test/hook-command.test.ts
@@ -310,3 +310,188 @@ describe("bundled Stop hook command", () => {
     expect(readHookCommand().replaceAll("${PLUGIN_ROOT}", "")).not.toContain("$");
