{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_bash_toolchain_guard.py"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_tmpdir_guard.py"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/bash_decision_gate.py"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_bash_boundary_wrap.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_tmpdir_guard.py"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_edit_lint_guard.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_edit_lint_guard.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_write_completion_gate.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_write_existing_guard.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_plan_code_guard.py"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_plan_code_guard.py"
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_plan_code_guard.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/universal_logger.py PreToolUse"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/suggest_checkpoint.py",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/post_edit_lint.py"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/post_edit_typecheck.py",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/post_edit_cyrillic_guard.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/post_edit_lint.py"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/post_edit_typecheck.py",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/post_edit_cyrillic_guard.py"
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/post_edit_cyrillic_guard.py"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/post_edit_cyrillic_guard.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/universal_logger.py PostToolUse",
            "async": true
          }
        ],
        "matcher": ".*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/proposal_discipline.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/stop_format.py"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/stop_lint_gate.py"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/proposal_discipline.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/universal_logger.py Stop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/session_save.py"
          },
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/pre_compact_mask.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/universal_logger.py PreCompact"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/session_prepare_python.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/universal_logger.py SessionStart"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/session_save.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/universal_logger.py SessionEnd"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/worktree-create",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/universal_logger.py WorktreeCreate"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/worktree-remove",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/.venv/bin/python ~/.claude/bin/universal_logger.py WorktreeRemove"
          }
        ]
      }
    ]
  }
}