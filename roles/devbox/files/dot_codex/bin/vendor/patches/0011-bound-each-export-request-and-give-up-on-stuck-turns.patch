index 0000000..7b64ff8
--- /dev/null
+++ b/plugins/tracing/src/bounded-export.ts
@@ -0,0 +1,222 @@
+import { LangfuseOtelSpanAttributes } from "@langfuse/tracing";
+import type { Attributes, AttributeValue } from "@opentelemetry/api";
+import { type ExportResult, ExportResultCode } from "@opentelemetry/core";
+import type { ReadableSpan, SpanExporter } from "@opentelemetry/sdk-trace-base";
+
+// Far below the edge's 128 MiB OTLP/HTTP body cap: the edge redacts every attribute value
+// before it answers, at a few MB/s, and the Stop hook has 30 s for the whole run.
+export const MAX_REQUEST_BYTES = 16 * 1024 * 1024;
+const MAX_REQUESTS_IN_FLIGHT = 4;
+const BASE_TIMEOUT_MS = 5_000;
+const BYTES_PER_EXTRA_SECOND = 2 * 1024 * 1024;
+const MAX_TIMEOUT_MS = 20_000;
+// Bounds the OTLP JSON fields an estimate leaves out: ids, times, status, flags, counts.
+const SPAN_ENVELOPE_BYTES = 1024;
+const PLACEHOLDER_ATTRIBUTE_BYTES = 4096;
+const OVERSIZED_METADATA = `${LangfuseOtelSpanAttributes.OBSERVATION_METADATA}.codex.oversized_bytes`;
+
+export function requestTimeoutMillis(bytes: number): number {
+  return Math.min(
+    MAX_TIMEOUT_MS,
+    BASE_TIMEOUT_MS + Math.ceil(bytes / BYTES_PER_EXTRA_SECOND) * 1000,
+  );
+}
+
+const jsonBytes = (value: unknown): number => Buffer.byteLength(JSON.stringify(value ?? null));
+
+function attributesBytes(attributes: Attributes): number {
+  let bytes = 0;
+  for (const [key, value] of Object.entries(attributes)) {
+    bytes += jsonBytes(key) + jsonBytes(value) + 48;
+  }
+  return bytes;
+}
+
+/** An upper estimate of the span's size in an OTLP/JSON request that holds it alone. */
+export function estimatedRequestBytes(span: ReadableSpan): number {
+  let bytes = SPAN_ENVELOPE_BYTES + jsonBytes(span.name) + attributesBytes(span.attributes);
+  for (const event of span.events) {
+    bytes += 128 + jsonBytes(event.name) + attributesBytes(event.attributes ?? {});
+  }
+  for (const link of span.links) bytes += 128 + attributesBytes(link.attributes ?? {});
+  bytes += attributesBytes(span.resource.attributes);
+  bytes += jsonBytes(span.instrumentationScope);
+  return bytes;
+}
+
+function withoutContent(span: ReadableSpan, bytes: number, maxBytes: number): ReadableSpan {
+  const attributes: Attributes = {};
+  let dropped = 0;
+  for (const [key, value] of Object.entries(span.attributes)) {
+    if (jsonBytes(value) <= PLACEHOLDER_ATTRIBUTE_BYTES) attributes[key] = value;
+    else dropped++;
+  }
+  const level = LangfuseOtelSpanAttributes.OBSERVATION_LEVEL;
+  if (attributes[level] !== "ERROR") attributes[level] = "WARNING";
+  const status = LangfuseOtelSpanAttributes.OBSERVATION_STATUS_MESSAGE;
+  attributes[status] = [
+    attributes[status],
+    `Exported without its content: ${bytes} bytes, over the ${maxBytes}-byte request cap`,
+  ]
+    .filter(Boolean)
+    .join("; ");
+  attributes[OVERSIZED_METADATA] = String(bytes);
+  return {
+    name: span.name,
+    kind: span.kind,
+    spanContext: () => span.spanContext(),
+    parentSpanContext: span.parentSpanContext,
+    startTime: span.startTime,
+    endTime: span.endTime,
+    status: span.status,
+    attributes,
+    links: span.links,
+    events: [],
+    duration: span.duration,
+    ended: span.ended,
+    resource: span.resource,
+    instrumentationScope: span.instrumentationScope,
+    droppedAttributesCount: span.droppedAttributesCount + dropped,
+    droppedEventsCount: span.droppedEventsCount + span.events.length,
+    droppedLinksCount: span.droppedLinksCount,
+  };
+}
+
+function reportOversized(span: ReadableSpan, bytes: number, maxBytes: number): void {
+  const session = span.attributes["session.id"] ?? "unknown";
+  process.stderr.write(
+    `[langfuse-codex] ${span.name} ${span.spanContext().spanId} of session ${String(session)} is ` +
+      `${bytes} bytes, over the ${maxBytes}-byte request cap: exported without its content\n`,
+  );
+}
+
+type Request = { spans: ReadableSpan[]; bytes: number };
+
+/**
+ * Sends each batch as OTLP requests of at most `maxBytes`, and remembers the first failure
+ * until `takeFailure`, because the batch processor reports a failed background export to no one.
+ */
+export class BoundedRequestExporter implements SpanExporter {
+  private readonly delegates = new Map<number, SpanExporter>();
+  private readonly waiting: Array<() => void> = [];
+  private inFlight = 0;
+  private failure: unknown;
+
+  constructor(
+    private readonly exporterWithTimeout: (timeoutMillis: number) => SpanExporter,
+    private readonly maxBytes: number = MAX_REQUEST_BYTES,
+  ) {}
+
+  export(spans: ReadableSpan[], resultCallback: (result: ExportResult) => void): void {
+    this.send(spans).then(resultCallback, (error: unknown) => {
+      this.failure ??= error;
+      resultCallback({ code: ExportResultCode.FAILED, error: asError(error) });
+    });
+  }
+
+  takeFailure(): unknown {
+    const failure = this.failure;
+    this.failure = undefined;
+    return failure;
+  }
+
+  async forceFlush(): Promise<void> {
+    await Promise.all([...this.delegates.values()].map((delegate) => delegate.forceFlush?.()));
+  }
+
+  async shutdown(): Promise<void> {
+    await Promise.all([...this.delegates.values()].map((delegate) => delegate.shutdown()));
+  }
+
+  private async send(spans: ReadableSpan[]): Promise<ExportResult> {
+    const results = await Promise.all(
+      this.requests(spans).map(async (request) => {
+        await this.acquire();
+        try {
+          return await this.sendRequest(request);
+        } finally {
+          this.release();
+        }
+      }),
+    );
+    const failed = results.find((result) => result.code !== ExportResultCode.SUCCESS);
+    if (!failed) return { code: ExportResultCode.SUCCESS };
+    this.failure ??= failed.error ?? new Error("OTLP export failed");
+    return failed;
+  }
+
+  private requests(spans: ReadableSpan[]): Request[] {
+    const requests: Request[] = [];
+    let current: Request = { spans: [], bytes: 0 };
+    for (const span of spans) {
+      let sent = span;
+      let bytes = estimatedRequestBytes(span);
+      if (bytes > this.maxBytes) {
+        reportOversized(span, bytes, this.maxBytes);
+        sent = withoutContent(span, bytes, this.maxBytes);
+        bytes = estimatedRequestBytes(sent);
+      }
+      if (current.spans.length > 0 && current.bytes + bytes > this.maxBytes) {
+        requests.push(current);
+        current = { spans: [], bytes: 0 };
+      }
+      current.spans.push(sent);
+      current.bytes += bytes;
+    }
+    if (current.spans.length > 0) requests.push(current);
+    return requests;
+  }
+
+  private sendRequest(request: Request): Promise<ExportResult> {
+    const timeoutMillis = requestTimeoutMillis(request.bytes);
+    let delegate = this.delegates.get(timeoutMillis);
+    if (!delegate) {
+      delegate = this.exporterWithTimeout(timeoutMillis);
+      this.delegates.set(timeoutMillis, delegate);
+    }
+    const target = delegate;
+    return new Promise((resolve) => target.export(request.spans, resolve));
+  }
+
+  private acquire(): Promise<void> {
+    if (this.inFlight < MAX_REQUESTS_IN_FLIGHT) {
+      this.inFlight++;
+      return Promise.resolve();
+    }
+    return new Promise((resolve) => this.waiting.push(resolve));
+  }
+
+  private release(): void {
+    const next = this.waiting.shift();
+    if (next) next();
+    else this.inFlight--;
+  }
+}
+
+const asError = (error: unknown): Error =>
+  error instanceof Error ? error : new Error(String(error));
+
+export type ExportFailure = "unreachable" | "rejected" | "failed";
+
+const UNREACHABLE_CODES = new Set([
+  "ECONNREFUSED",
+  "ENOTFOUND",
+  "EHOSTUNREACH",
+  "ENETUNREACH",
+  "EAI_AGAIN",
+]);
+const TRANSIENT_STATUSES = new Set([408, 429]);
+
+/**
+ * `unreachable`: no collector answered, so the turn is not at fault. `rejected`: a 4xx the
+ * collector will repeat for the same body. `failed`: anything else, retried a bounded number of runs.
+ */
+export function exportFailureKind(error: unknown): ExportFailure {
+  const code =
+    typeof error === "object" && error !== null ? (error as { code?: unknown }).code : undefined;
+  if (typeof code === "string" && UNREACHABLE_CODES.has(code)) return "unreachable";
+  if (typeof code === "number" && code >= 400 && code < 500 && !TRANSIENT_STATUSES.has(code)) {
+    return "rejected";
+  }
+  return "failed";
+}
