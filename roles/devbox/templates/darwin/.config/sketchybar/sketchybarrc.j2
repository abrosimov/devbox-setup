#!/usr/bin/env lua
-- Managed by devbox (roles/devbox/templates/darwin/.config/sketchybar/sketchybarrc.j2).
-- Edits here are overwritten on the next run.
--
-- Declares the bar and its items only. No item runs an update script: every
-- value is pushed by Hammerspoon (~/.hammerspoon/modules/bar.lua), which owns
-- the item names used here. The only scripts are the workspaces' click actions.
-- SketchyBar runs this file through `sh -c`, so the shebang picks Homebrew's
-- lua from the service's PATH.

local HEIGHT = {{ devbox_sketchybar_height }}
local FONT = "{{ devbox_sketchybar_font }}"

-- Kanagawa; the same values as modules/bar_render.lua.
local BG = "0xff1f1f28"
local FG = "0xffdcd7ba"

local args = {}
local function add(...)
	for _, v in ipairs({ ... }) do
		args[#args + 1] = v
	end
end

add(
	"--bar",
	"position=top",
	"height=" .. HEIGHT,
	"color=" .. BG,
	"display=all",
	"sticky=on",
	"padding_left=6",
	"padding_right=6"
)

add(
	"--default",
	"icon.drawing=off",
	"label.font=" .. FONT,
	"label.color=" .. FG,
	"padding_left=3",
	"padding_right=3"
)

-- Workspaces 1-9; Hammerspoon sets each one's display, label and colours.
-- A click switches to the workspace; Rift numbers them from 0. The click
-- script runs through `sh -c`, which expands $HOME.
for n = 1, 9 do
	local item = "ws." .. n
	add(
		"--add",
		"item",
		item,
		"left",
		"--set",
		item,
		"label=" .. n,
		"label.padding_left=7",
		"label.padding_right=7",
		"background.corner_radius=5",
		"background.height=" .. (HEIGHT - 8),
		'click_script="$HOME/.local/bin/rift-cli" execute workspace switch ' .. (n - 1),
		"drawing=off"
	)
end

add("--add", "item", "front_app", "left", "--set", "front_app", "padding_left=12")

-- Right side, rightmost first. The otelbox edge item exists only where the
-- edge runs; Hammerspoon reads the declared items and sets it only then.
local RIGHT = { "clock", "battery", "ram", "cpu", {% if devbox_packages.otelbox_edge.enabled | default(true) %}"edge", {% endif %}"input" }
-- These items have an icon: a Nerd Font glyph that Hammerspoon sets.
local ICON_PROPS = { "icon.drawing=on", "icon.font=" .. FONT, "icon.padding_right=4" }
local ICON = { cpu = ICON_PROPS, ram = ICON_PROPS, edge = ICON_PROPS }
for _, item in ipairs(RIGHT) do
	add("--add", "item", item, "right", "--set", item, "padding_left=10", table.unpack(ICON[item] or {}))
end

local function quote(s)
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

local words = { "sketchybar" }
for _, v in ipairs(args) do
	words[#words + 1] = quote(v)
end
local ok = os.execute(table.concat(words, " "))
os.exit(ok and 0 or 1)
